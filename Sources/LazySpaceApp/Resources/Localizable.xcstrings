    "coordinator.lazySpaceAskedAWindowOr" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LazySpace hat ein Fenster oder eine App im Ziel-Space aufgefordert, in den Vordergrund zu kommen, konnte den Space-Wechsel aber nicht bestätigen. Das schrittweise Wechseln wurde nicht versucht, weil der Wechsel noch erfolgen kann."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LazySpace asked a window or app on the target Space to come to the front, but the Space switch could not be confirmed. Stepping was not attempted because the switch may still happen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LazySpace pidió a una ventana o app del Space de destino que pasara al frente, pero no se pudo confirmar el cambio de Space. No se intentó el paso a paso porque el cambio aún puede producirse."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LazySpace a demandé à une fenêtre ou à une app du Space cible de passer au premier plan, mais le changement de Space n’a pas pu être confirmé. Le passage pas à pas n’a pas été tenté, car le changement peut encore se produire."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目標の操作スペースのウインドウまたはアプリを前面にするよう要求しましたが、操作スペースの切り替えを確認できませんでした。遅れて切り替わることがあるため、1つずつの移動は行っていません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LazySpace가 대상 Space의 윈도우 또는 앱을 앞으로 가져오도록 요청했지만 Space 전환을 확인할 수 없었습니다. 전환이 나중에 일어날 수 있으므로 Space를 한 단계씩 이동하는 방법은 시도하지 않았습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O LazySpace pediu que uma janela ou um app do Space de destino viesse para a frente, mas não foi possível confirmar a troca de Space. O avanço por etapas não foi tentado porque a troca ainda pode acontecer."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LazySpace已请求目标空间中的窗口或应用移到最前面，但无法确认空间已切换。由于切换可能仍会发生，因此未尝试逐个切换。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LazySpace已要求目標空間中的視窗或App移至最前方，但無法確認空間已切換。由於仍可能切換，因此未嘗試逐一切換。"
          }
        }
      }
    },
    "coordinator.lazySpaceBroughtAnAppForward" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LazySpace hat eine App in den Vordergrund geholt, konnte aber nicht bestätigen, dass sie aktiv wurde, und hat dort aufgehört. Möglicherweise ist LazySpace selbst noch die aktive App."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LazySpace brought an app forward, but could not confirm that the app became active, so it stopped there. LazySpace itself may still be the active app."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LazySpace trajo una app al frente, pero no pudo confirmar que la app se activara, así que se detuvo ahí. Puede que LazySpace siga siendo la app activa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LazySpace a fait passer une app au premier plan, mais n’a pas pu confirmer qu’elle était devenue active ; il s’est donc arrêté là. LazySpace est peut-être encore l’app active."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリを前面にしましたが、そのアプリが前面になったことを確認できなかったため、そこで止めました。LazySpaceが前面のまま残っていることがあります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LazySpace가 앱을 앞으로 가져왔지만 해당 앱이 활성화되었는지 확인할 수 없어 거기서 중단했습니다. LazySpace 자체가 여전히 활성 앱일 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O LazySpace trouxe um app para a frente, mas não pôde confirmar que o app ficou ativo, por isso parou aí. O próprio LazySpace ainda pode ser o app ativo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LazySpace已将某个应用移到前面，但无法确认该应用已成为活跃应用，因此在此停止。LazySpace本身可能仍是活跃应用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LazySpace已將某個App移至最前方，但無法確認該App已成為使用中的App，因此在此停止。LazySpace本身可能仍是使用中的App。"
          }
        }
      }
    },
    "coordinator.lazySpaceCanSwitchToA" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LazySpace kann nur zu einem Space eines anderen Displays wechseln, indem es dort ein Fenster oder eine App in den Vordergrund holt, und keines ließ sich verwenden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LazySpace can switch to a Space of another display only by bringing forward a window or app there, and none could be used."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LazySpace solo puede cambiar a un Space de otra pantalla trayendo al frente una ventana o app que esté allí, y no se pudo usar ninguna."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LazySpace ne peut passer à un Space d’un autre écran qu’en y faisant passer une fenêtre ou une app au premier plan, et aucune n’a pu servir."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "別のディスプレイの操作スペースへは、そこにあるウインドウかアプリを前面にすることでしか切り替えられません。使えるものがありませんでした。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LazySpace는 해당 디스플레이의 윈도우나 앱을 앞으로 가져와야만 다른 디스플레이의 Space로 전환할 수 있는데, 사용할 수 있는 윈도우나 앱이 없었습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O LazySpace só consegue ir para um Space de outra tela trazendo para a frente uma janela ou um app que esteja lá, e nenhum pôde ser usado."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LazySpace只能通过将其他显示器上的窗口或应用移到前面来切换到该显示器的空间，但没有可用的窗口或应用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LazySpace只能透過將其他顯示器上的視窗或App移至最前方，來切換至該顯示器的空間，但沒有可用的視窗或App。"
          }
        }
      }
    },
    "coordinator.lazySpaceSentTheMacOSShortcut" : {
      "comment" : "Arguments: 1 = `name`.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LazySpace hat den macOS-Kurzbefehl „%@“ gesendet, konnte den Space-Wechsel aber nicht bestätigen. Es wurde nichts weiter versucht, weil der Wechsel noch erfolgen kann."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LazySpace sent the macOS “%@” shortcut, but could not confirm the Space switch. Nothing else was tried because the switch may still happen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LazySpace envió el atajo “%@” de macOS, pero no pudo confirmar el cambio de Space. No se probó nada más porque el cambio aún puede producirse."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LazySpace a envoyé le raccourci macOS « %@ », mais n’a pas pu confirmer le changement de Space. Rien d’autre n’a été tenté, car le changement peut encore se produire."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOSの「%@」のショートカットを送りましたが、操作スペースの切り替えを確認できませんでした。遅れて切り替わることがあるため、ほかの方法は試していません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LazySpace가 macOS의 ‘%@’ 단축키를 보냈지만 Space 전환을 확인할 수 없었습니다. 전환이 나중에 일어날 수 있으므로 다른 방법은 시도하지 않았습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O LazySpace enviou o atalho “%@” do macOS, mas não pôde confirmar a troca de Space. Nada mais foi tentado porque a troca ainda pode acontecer."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LazySpace已发送macOS的“%@”快捷键，但无法确认空间已切换。由于切换可能仍会发生，因此未尝试其他方法。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",

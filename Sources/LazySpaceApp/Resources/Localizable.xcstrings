    "cliHelp.reload" : {
      "comment" : "A command's description in lazyspace help.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Neuladen der Konfiguration anfordern (Änderungen an der Datei werden auch automatisch neu geladen; Fenster werden nicht bewegt)"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Request a configuration reload (changes to the file are also reloaded automatically; windows are not moved)"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solicitar la recarga de la configuración (los cambios en el archivo también se recargan automáticamente; las ventanas no se mueven)"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demander un rechargement de la configuration (les modifications du fichier sont aussi rechargées automatiquement ; les fenêtres ne sont pas déplacées)"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "設定の再読み込みを要求（ファイルの変更は自動でも再読み込みする。ウインドウは動かさない）"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "설정 다시 로드 요청(파일 변경 사항도 자동으로 다시 로드됨, 윈도우는 이동하지 않음)"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solicitar a recarga da configuração (alterações no arquivo também são recarregadas automaticamente; as janelas não se movem)"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请求重新载入配置（文件的更改也会自动重新载入；不移动窗口）"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要求重新載入設定（檔案的變更也會自動重新載入；不會移動視窗）"
          }
        }
      }
    },
    "cliHelp.requestToken" : {
      "comment" : "A command's description in lazyspace help.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Anfrage-ID für eine Änderung reservieren (ändert weder Fenster, Layout, Fokus noch Einstellungen)"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reserve a mutation request ID (no window, layout, focus, or settings change)"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reservar un ID de solicitud de cambio (no cambia ventanas, disposición, foco ni ajustes)"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Réserver un ID de demande de modification (sans changer de fenêtre, de disposition, de fenêtre active ni de réglage)"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "変更要求のIDを予約する（ウインドウ・配置・フォーカス・設定は変えない）"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "변경 요청 ID 예약(윈도우, 레이아웃, 초점, 설정은 변경하지 않음)"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reservar um ID de solicitação de alteração (não muda janelas, layout, foco nem ajustes)"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "预留一个更改请求ID（不更改窗口、布局、焦点或设置）"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "預留變更要求的ID（不會變更視窗、佈局、焦點或設定）"
          }
        }
      }
    },
    "cliHelp.resizeAxisAmount" : {
      "comment" : "A command's description in lazyspace help.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "<Achse> ist width, height oder smart; [Betrag] ist ein Verhältnis wie +0.05 oder -0.05 (Standard +0.05)"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "<axis> is width, height, or smart; [amount] is a ratio such as +0.05 or -0.05 (default +0.05)"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "<eje> es width, height o smart; [cantidad] es una proporción como +0.05 o -0.05 (por omisión +0.05)"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "<axe> est width, height ou smart ; [quantité] est un rapport comme +0.05 ou -0.05 (par défaut +0.05)"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "<軸>はwidth / height / smart、[量]は+0.05や-0.05のような比率（初期値+0.05）"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "<축>은 width, height, smart 중 하나, [양]은 +0.05 또는 -0.05 같은 비율(기본값 +0.05)"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "<eixo> é width, height ou smart; [valor] é uma proporção como +0.05 ou -0.05 (padrão +0.05)"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "<轴>为width、height或smart；[幅度]为比例，如+0.05或-0.05（默认为+0.05）"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "<軸>為width、height或smart；[幅度]為比例，例如+0.05或-0.05（預設值為+0.05）"
          }
        }
      }
    },

    "coordinator.lazySpaceSwitchedToASpace" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LazySpace hat unterwegs zu einem Space gewechselt, doch danach änderte sich die Reihenfolge der Spaces auf diesem Display, daher wurden die restlichen Schritte nicht gesendet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LazySpace switched to a Space on the way, but the order of Spaces on this display then changed, so the remaining steps were not sent."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LazySpace cambió a un Space intermedio, pero luego cambió el orden de los Spaces de esta pantalla, así que no se enviaron los pasos restantes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LazySpace est passé à un Space intermédiaire, mais l’ordre des Spaces de cet écran a ensuite changé ; les étapes restantes n’ont donc pas été envoyées."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "途中の操作スペースへ切り替えましたが、その後このディスプレイの操作スペースの並びが変わったため、残りの移動は送っていません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LazySpace가 중간에 있는 Space로 전환했지만 이후 이 디스플레이의 Space 순서가 바뀌어 남은 이동은 보내지 않았습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O LazySpace foi para um Space no caminho, mas a ordem dos Spaces nesta tela mudou em seguida, por isso as etapas restantes não foram enviadas."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LazySpace已切换到途中的某个空间，但此显示器上的空间顺序随后发生了变化，因此未发送剩余的步骤。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LazySpace已切換至途中的空間，但此顯示器上的空間順序隨後改變，因此未傳送其餘的切換。"
          }
        }
      }
    },

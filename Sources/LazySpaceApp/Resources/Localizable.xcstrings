    "coordinator.turnedOffOpenAtLogin" : {
      "comment" : "Arguments: 1 = `fixed`.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Bei der Anmeldung öffnen“ wurde ausgeschaltet. Die Konfigurationsdatei setzt start-at-login = %@, daher stellt das nächste Neuladen es wieder um. Ändere auch die Konfigurationsdatei."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turned off Open at Login. The configuration file sets start-at-login = %@, so the next reload changes it back. Update the configuration file as well."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se desactivó “Abrir al iniciar sesión”. El archivo de configuración establece start-at-login = %@, así que la próxima recarga lo revertirá. Actualiza también el archivo de configuración."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« Ouvrir avec la session » désactivé. Le fichier de configuration définit start-at-login = %@ ; le prochain rechargement le rétablira. Mettez aussi à jour le fichier de configuration."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「ログイン時に開く」をオフにしました。設定ファイルにstart-at-login = %@があるため、次の再読み込みで戻ります。設定ファイルも変更してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘로그인 시 열기’를 껐습니다. 설정 파일에 start-at-login = %@이(가) 지정되어 있으므로 다음에 다시 로드하면 원래대로 돌아갑니다. 설정 파일도 수정하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Abrir no Início da Sessão” foi desativado. O arquivo de configuração define start-at-login = %@, por isso a próxima recarga reverte a mudança. Atualize também o arquivo de configuração."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已关闭“登录时打开”。配置文件设定了start-at-login = %@，因此下次重新载入时会改回。请同时更新配置文件。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已關閉「在登入時打開」。設定檔中設定了start-at-login = %@，因此下次重新載入時會改回。請同時更新設定檔。"
          }
        }
      }
    },

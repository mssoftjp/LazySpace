    "settingsWindow.toChangeAShortcutDouble" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um einen Kurzbefehl zu ändern, doppelklicke ihn oder drücke den Zeilenschalter und gib dann die neuen Tasten ein. Die Rückschritttaste entfernt ihn, ⌥ und Rückschritttaste stellen den Standard wieder her, esc bricht ab."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To change a shortcut, double-click it or press Return, then type the new keys. Delete removes it; Option-Delete restores its default; Esc cancels."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para cambiar un atajo, haz doble clic en él o pulsa Retorno y escribe las teclas nuevas. Suprimir lo quita; Opción + Suprimir restaura su valor por omisión; Esc cancela."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour modifier un raccourci, double-cliquez dessus ou appuyez sur Retour, puis saisissez les nouvelles touches. Supprimer le retire ; Option-Supprimer rétablit sa valeur par défaut ; Esc annule."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ショートカットを変更するには、ダブルクリックするかReturnを押して新しいキーを入力します。Deleteで解除、⌥Deleteでデフォルトに戻し、Escでキャンセルします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "단축키를 변경하려면 두 번 클릭하거나 Return 키를 누른 다음 새 키를 입력하십시오. Delete 키를 누르면 제거되고, Option-Delete 키를 누르면 기본값으로 복원되며, Esc 키를 누르면 취소됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para alterar um atalho, clique duas vezes nele ou pressione Return e digite as novas teclas. Delete remove o atalho; Option-Delete restaura o padrão; Esc cancela."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "若要更改快捷键，请连按该快捷键或按下Return键，然后键入新按键。按Delete键可将其移除；按Option-Delete键可恢复默认；按Esc键可取消。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "若要更改快速鍵，請按兩下該快速鍵或按下Return，然後輸入新的按鍵。按Delete可移除；按Option-Delete可回復預設值；按Esc可取消。"
          }
        }
      }
    },

    "settingsWindow.tryAgainWritesThisChange" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Erneut versuchen“ schreibt diese Änderung. „Verwerfen“ lädt die Datei und lässt die Änderung fallen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",

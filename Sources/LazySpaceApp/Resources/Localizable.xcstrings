        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LazySpace a cessé d’organiser les fenêtres parce qu’il n’y est plus autorisé. Activez LazySpace dans Confidentialité et sécurité › %@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "許可がオフになったため、LazySpaceはウインドウの整列を止めています。プライバシーとセキュリティ › %@でLazySpaceをオンにしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LazySpace가 더 이상 허용되지 않아 윈도우 정렬을 중단했습니다. 개인정보 보호 및 보안 › %@에서 LazySpace를 켜십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O LazySpace parou de organizar as janelas porque não tem mais permissão. Ative o LazySpace em Privacidade e Segurança › %@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LazySpace不再获得允许，因此已停止排列窗口。请在隐私与安全 › %@中打开LazySpace。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",

    "appDelegate.theSameExecutableWorksAs" : {
      "comment" : "Arguments: 1 = `command`.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The same executable works as a command-line tool when it is called with the lowercase name lazyspace. Create a symbolic link in a folder on your PATH. This is not needed if you installed LazySpace with Homebrew Cask.\n\n%@\n\nExamples:\nlazyspace status\nlazyspace focus left\nlazyspace list-spaces\nlazyspace help"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同じ実行ファイルを小文字のlazyspaceという名前で呼ぶとCLIとして動きます。PATHの通った場所にシンボリックリンクを置いてください（Homebrew Caskで入れた場合は不要）。\n\n%@\n\n例:\nlazyspace status\nlazyspace focus left\nlazyspace list-spaces\nlazyspace help"
          }
        }
      }
    },
    "appDelegate.theSelectedWindowChangedOpen" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The selected window changed. Open the menu again."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "対象のウインドウが変わりました。メニューを開き直してください。"
          }
        }

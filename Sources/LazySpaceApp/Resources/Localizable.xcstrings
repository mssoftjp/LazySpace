    "coordinator.afterReachingTheTargetSpace" : {
      "comment" : "Arguments: 1 = `spaceLabel(to)`.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nach dem Erreichen des Ziel-Space wechselte der aktuelle Space zu %@. Die Ursache konnte nicht ermittelt werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "After reaching the target Space, the current Space changed to %@. The cause could not be determined."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tras llegar al Space de destino, el Space actual cambió a %@. No se pudo determinar la causa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Après l’arrivée sur le Space cible, le Space actuel est passé à %@. La cause n’a pas pu être déterminée."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目標の操作スペースを確認した後、現在の操作スペースが%@に変わりました。切り替わった原因は確認できていません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "대상 Space에 도달한 후 현재 Space가 %@(으)로 변경되었습니다. 원인을 확인할 수 없습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Depois de chegar ao Space de destino, o Space atual mudou para %@. Não foi possível determinar a causa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "到达目标空间后，当前空间变为%@。无法确定原因。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "到達目標空間後，目前的空間變更為%@。無法確定原因。"
          }
        }
      }
    },
    "coordinator.afterTheMoveRequestThe" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nach der Bewegungsanfrage konnte der Space des Fensters nicht gelesen werden. Das Fenster wurde möglicherweise geschlossen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "After the move request, the window's Space could not be read. The window may have closed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tras la solicitud de movimiento, no se pudo leer el Space de la ventana. Puede que la ventana se haya cerrado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Après la demande de déplacement, le Space de la fenêtre n’a pas pu être lu. La fenêtre s’est peut-être fermée."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "移動の要求のあと、ウインドウの所属を読めませんでした。ウインドウが閉じた可能性があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이동 요청 후 윈도우의 Space를 읽을 수 없었습니다. 윈도우가 닫혔을 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Depois da solicitação de movimento, não foi possível ler o Space da janela. A janela pode ter sido fechada."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "发出移动请求后，无法读取窗口所在的空间。窗口可能已关闭。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要求移動後，無法讀取視窗所屬的空間。視窗可能已關閉。"
          }
        }
      }
    },
    "coordinator.afterTheWindowMovedInput" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nachdem das Fenster bewegt wurde, haben sich Eingabe, Pausenstatus oder der aktuelle Space geändert, daher wurden die Positionskorrektur und die Aufnahme in das Layout abgebrochen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "After the window moved, input, pause state, or the current Space changed, so position correction and adding it to the layout were canceled."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Después de mover la ventana cambió la entrada, el estado de pausa o el Space actual, así que se cancelaron la corrección de posición y su adición a la disposición."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Après le déplacement de la fenêtre, une saisie, l’état de pause ou le Space actuel a changé ; la correction de position et l’ajout à la disposition ont donc été annulés."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ウインドウの移動後に入力・停止・操作スペースの状態が変わったため、位置の補正とレイアウトへの追加を中止しました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "윈도우가 이동한 후 입력, 일시 정지 상태 또는 현재 Space가 변경되어 위치 보정과 레이아웃 추가를 취소했습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Depois que a janela se moveu, uma entrada, a pausa ou o Space atual mudou, por isso a correção da posição e a adição ao layout foram canceladas."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "窗口移动后，输入、暂停状态或当前空间发生了变化，因此已取消位置校正和加入布局。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "視窗移動後，輸入、暫停狀態或目前的空間發生變化，因此已取消位置修正及加入佈局。"
          }
        }
      }
    },
    "coordinator.allSpacesArePausedSo" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle Spaces sind angehalten, daher wurde das Layout nicht geändert. Setze LazySpace fort und versuche es dann erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "All Spaces are paused, so the layout was not changed. Resume LazySpace, then try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todos los Spaces están en pausa, así que la disposición no cambió. Reanuda LazySpace e inténtalo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tous les Spaces sont en pause, la disposition n’a donc pas été modifiée. Reprenez LazySpace, puis réessayez."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべての操作スペースが一時停止中のため編集しません。再開してから操作してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 Space가 일시 정지되어 레이아웃을 변경하지 않았습니다. LazySpace를 재개한 다음 다시 시도하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todos os Spaces estão em pausa, por isso o layout não foi alterado. Retome o LazySpace e tente de novo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所有空间均已暂停，因此未更改布局。请继续运行LazySpace，然后重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所有空間皆已暫停，因此未變更佈局。請繼續執行LazySpace，然後再試一次。"
          }
        }
      }
    },
    "coordinator.allSpacesRemainPausedBecause" : {
      "comment" : "Arguments: 1 = `AccessPane.name()`; 2 = `resume`.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle Spaces bleiben angehalten, weil LazySpace unter „%@“ nicht erlaubt ist. Erlaube es und wähle dann „%@“."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "All Spaces remain paused because LazySpace is not allowed in %@. Allow it, then choose %@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todos los Spaces siguen en pausa porque LazySpace no está permitido en “%@”. Permítelo y luego elige “%@”."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tous les Spaces restent en pause parce que LazySpace n’est pas autorisé dans « %@ ». Autorisez-le, puis choisissez « %@ »."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」でLazySpaceが許可されていないため、一時停止を続けています。許可してから「%@」を選んでください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘%1$@’에서 LazySpace가 허용되지 않아 모든 Space가 일시 정지된 상태입니다. 허용한 다음 ‘%2$@’을(를) 선택하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todos os Spaces continuam em pausa porque o LazySpace não tem permissão em “%@”. Permita e depois escolha “%@”."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LazySpace未在“%@”中获得允许，因此所有空间仍处于暂停状态。请允许后选择“%@”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "由於LazySpace未在「%@」中獲得允許，所有空間仍維持暫停。請允許後再選擇「%@」。"
          }
        }
      }
    },

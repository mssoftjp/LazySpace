    "nativeShortcutStatus.withTheseSettingsIsAssigned" : {
      "comment" : "Arguments: 1 = `shown`; 2 = `name`.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit diesen Einstellungen ist %@ sowohl in LazySpace als auch für „%@“ belegt, daher funktioniert das schrittweise Wechseln nach rechts nicht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "With these settings, %@ is assigned in LazySpace and to “%@”, so stepwise switching to the right won't work."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con estos ajustes, %@ está asignado en LazySpace y a “%@”, así que el cambio paso a paso hacia la derecha no funcionará."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avec ces réglages, %@ est attribué dans LazySpace et à « %@ » ; le passage pas à pas vers la droite ne fonctionnera pas."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この設定では、%@がLazySpaceと「%@」の両方に割り当てられているため、操作スペースを右へ順に切り替えられません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 설정에서는 %@ 키가 LazySpace와 ‘%@’에 모두 할당되어 있어 오른쪽으로 Space를 한 단계씩 전환할 수 없습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Com estes ajustes, %@ está atribuído no LazySpace e a “%@”, por isso a mudança de Space passo a passo para a direita não vai funcionar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按照这些设置，%1$@同时分配给了LazySpace和“%2$@”，因此无法逐个向右切换空间。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "依照這些設定，%@同時指定給LazySpace和「%@」，因此無法向右逐一切換空間。"
          }
        }
      }
    },

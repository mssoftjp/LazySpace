      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: %@ and %@ use the same shortcut %@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: %@と%@が同じショートカット%@を使っています。"
          }
        }
      }
    },
    "config.boolProblem" : {

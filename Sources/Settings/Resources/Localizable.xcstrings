    "config.couldNotReadExampleAlt" : {
      "comment" : "Arguments: 1 = `label`; 2 = `name`; 3 = `text`.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@.%@: %@ konnte nicht gelesen werden. Beispiel: alt-shift-h."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@.%@: could not read %@. Example: alt-shift-h."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@.%@: no se pudo leer %@. Ejemplo: alt-shift-h."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@.%@ : impossible de lire %@. Exemple : alt-shift-h."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@.%@: %@を解釈できません（例: alt-shift-h）。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@.%@: %@을(를) 해석할 수 없습니다. 예: alt-shift-h."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@.%@: não foi possível ler %@. Exemplo: alt-shift-h."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@.%@：无法解析%@。示例：alt-shift-h。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@.%@：無法讀取%@。範例：alt-shift-h。"
          }
        }
      }
    },
    "config.doNotDeclareModeMain" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deklariere mode.main nicht. Kurzbefehle des Hauptmodus gehören in [keys]."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Do not declare mode.main. Put main-mode shortcuts in [keys]."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No declares mode.main. Pon los atajos del modo main en [keys]."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne déclarez pas mode.main. Placez les raccourcis du mode principal dans [keys]."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "mode.mainは宣言しないでください。mainモードのショートカットは[keys]に書きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "mode.main은 선언하지 마십시오. main 모드 단축키는 [keys]에 넣으십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não declare mode.main. Coloque os atalhos do modo main em [keys]."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请勿声明mode.main。请将main模式的快捷键放在[keys]中。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請勿宣告mode.main。請將main模式的快速鍵放在[keys]中。"
          }
        }
      }
    },

        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "keys.%@: 단일 키는 일반 입력을 가로채므로 main 모드에서는 %@에 보조 키가 필요합니다. 단일 키는 기능 키이거나 모드 안에서만 사용할 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "keys.%@: %@ precisa de uma tecla modificadora no modo main, porque uma tecla sozinha capturaria a digitação normal. Teclas sozinhas são permitidas para teclas de função ou dentro de um modo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "keys.%1$@：在main模式中，%2$@需要修饰键，因为单个按键会拦截正常的键入。功能键或模式内可以使用单个按键。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {

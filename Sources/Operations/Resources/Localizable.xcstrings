    "arrangeOperation.arrangedUnobservedLeft" : {
      "comment" : "Arguments: 1 = how many windows were arranged; 2 = the apps that did not answer, joined by copy.listSeparator.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arranged %#@windows@. %2$@ didn't return a window list in time, so its windows were left where they are."
          },
          "substitutions" : {
            "windows" : {
              "argNum" : 1,
              "formatSpecifier" : "lld",
              "variations" : {
                "plural" : {
                  "one" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%arg window"
                    }
                  },
                  "other" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%arg windows"
                    }
                  }
                }
              }
            }
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lldつのウインドウを整列しました。%2$@がウインドウの一覧を期限内に返さなかったため、そのウインドウはそのままにしています。"
          }
        }
      }
    },
    "arrangeOperation.arrangedUnobservedUnconfirmed" : {
      "comment" : "Arguments: 1 = how many windows were arranged; 2 = the apps that did not answer, joined by copy.listSeparator.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arranged %#@windows@, but %2$@ didn't return a window list in time, so the set of windows couldn't be confirmed. Arrange again once that app responds."
          },
          "substitutions" : {
            "windows" : {
              "argNum" : 1,
              "formatSpecifier" : "lld",
              "variations" : {
                "plural" : {
                  "one" : {
                    "stringUnit" : {

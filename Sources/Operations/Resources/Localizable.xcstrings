    "arrangeOperation.theFixedSizeWindowsCould" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Fenster mit fester Größe konnten nicht neben den angeordneten Fenstern platziert werden, daher wurde diese Änderung nicht gesichert. LazySpace versucht es erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The fixed-size windows could not be placed next to the arranged windows, so this change was not saved. LazySpace will try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las ventanas de tamaño fijo no se pudieron colocar junto a las ventanas organizadas, así que este cambio no se guardó. LazySpace lo volverá a intentar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les fenêtres à taille fixe n’ont pas pu être placées à côté des fenêtres organisées ; cette modification n’a donc pas été enregistrée. LazySpace réessaiera."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "大きさが固定のウインドウを整列したウインドウと並べられなかったため、この変更は保存していません。あらためて試します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "크기가 고정된 윈도우를 정렬된 윈도우 옆에 둘 수 없어 이 변경 사항을 저장하지 않았습니다. LazySpace가 다시 시도합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As janelas de tamanho fixo não puderam ser colocadas ao lado das janelas organizadas, por isso esta alteração não foi salva. O LazySpace vai tentar de novo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法将固定大小的窗口放在已排列的窗口旁边，因此未存储此更改。LazySpace会再次尝试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法將固定大小的視窗放在已排列的視窗旁，因此未儲存此變更。LazySpace會再試一次。"
          }
        }
      }
    },
    "arrangeOperation.theMinimumSizeOfIs" : {
      "comment" : "Arguments: 1 = `name(id)`; 2 = `Int(required.width)`; 3 = `Int(required.height)`; 4 = `Int(available.width)`; 5 = `Int(available.height)`.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Mindestgröße von %@ (%@×%@) ist größer als der Arbeitsbereich (%@×%@). Schließe dieses Fenster aus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The minimum size of %@ (%@×%@) is larger than the work area (%@×%@). Exclude that window."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El tamaño mínimo de %@ (%@×%@) es mayor que el área de trabajo (%@×%@). Excluye esa ventana."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La taille minimale de la fenêtre de l’app « %@ » (%@×%@) dépasse la zone de travail (%@×%@). Excluez cette fenêtre."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@の最小サイズ%@×%@が領域%@×%@を超えています。そのウインドウを除外してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@의 최소 크기(%@×%@)가 작업 영역(%@×%@)보다 큽니다. 해당 윈도우를 제외하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O tamanho mínimo de %@ (%@×%@) é maior que a área útil (%@×%@). Exclua essa janela."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@窗口的最小大小（%2$@×%3$@）大于工作区域（%4$@×%5$@）。请排除该窗口。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@的最小尺寸（%@×%@）大於工作區域（%@×%@）。請排除該視窗。"
          }
        }
      }
    },
    "arrangeOperation.theNewWindowCantJoin" : {
      "comment" : "Arguments: 1 = `target.app`.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das neue Fenster kann nicht in das Layout aufgenommen werden, ohne das Fenster der App „%@“ zu bewegen, das du gerade benutzt, daher bleibt es an Ort und Stelle und wartet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The new window can't join the layout without moving the %@ window you're using, so it stays in place and waits."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La ventana nueva no puede entrar en la disposición sin mover la ventana de la app “%@” que estás usando, así que se queda en su sitio y espera."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La nouvelle fenêtre ne peut pas rejoindre la disposition sans déplacer la fenêtre de l’app « %@ » que vous utilisez ; elle reste donc en place et attend."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@のウインドウ（操作中）を動かさずには配置に入れられないため、新しいウインドウは位置を保って待機させます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사용 중인 ‘%@’ 앱의 윈도우를 이동하지 않고는 새 윈도우를 레이아웃에 추가할 수 없어 새 윈도우는 현재 위치에서 대기합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A janela nova não pode entrar no layout sem mover a janela do app “%@” que você está usando, por isso fica no lugar e aguarda."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新窗口必须移动你正在使用的%@窗口才能加入布局，因此它会保持原位并等待。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新視窗必須移動你正在使用的%@視窗才能加入佈局，因此會維持原位並等待。"
          }
        }
      }
    },
    "arrangeOperation.theWindowToAddIsnt" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das hinzuzufügende Fenster ist nicht einbezogen (es ist vorübergehend, oder sein Typ lässt sich nicht bestimmen). Ausgeschlossene Fenster und die Gründe stehen in der Fensterliste."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The window to add isn't eligible (it's temporary, or its type can't be determined). See the window list for excluded windows and reasons."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La ventana que se iba a añadir no se puede incluir (es temporal o no se puede determinar su tipo). Consulta la lista de ventanas para ver las ventanas excluidas y los motivos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La fenêtre à ajouter ne peut pas être incluse (elle est temporaire, ou son type ne peut pas être déterminé). Consultez la liste des fenêtres pour voir les fenêtres exclues et les raisons."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "追加するウインドウは整列対象ではありません（一時的なウインドウ、または種類を判定できないウインドウ）。除外されたウインドウと理由は一覧で確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "추가할 윈도우가 정렬 대상이 아닙니다(임시 윈도우이거나 유형을 확인할 수 없음). 제외된 윈도우와 그 이유는 윈도우 목록에서 확인하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A janela a adicionar não está incluída (é temporária ou o tipo dela não pode ser determinado). Veja na lista de janelas as janelas excluídas e os motivos."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要添加的窗口不可排列（它是临时窗口，或无法确定其类型）。请在窗口列表中查看已排除的窗口及原因。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要加入的視窗無法排列（它是暫時性視窗，或無法判斷其類型）。請查看視窗列表中已排除的視窗及原因。"
          }
        }
      }
    },

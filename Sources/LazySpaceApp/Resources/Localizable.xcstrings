{
  "sourceLanguage" : "en",
  "strings" : {
    "actionPictogram.addsOneWaitingWindowTo" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adds one waiting window to the layout."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "待機中のウインドウを1つレイアウトに加えます。"
          }
        }
      }
    },
    "actionPictogram.arrangesThisSpaceAndStarts" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arranges this Space and starts tiling it."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この操作スペースを整列し、タイル配置を始めます。"
          }
        }
      }
    },
    "actionPictogram.closesTheFocusedWindow" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Closes the focused window."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フォーカス中のウインドウを閉じます。"
          }
        }
      }
    },
    "actionPictogram.fillsTheWorkAreaWith" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fills the work area with the focused window, or restores the tiled layout."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フォーカス中のウインドウを作業領域いっぱいに広げる、または整列した表示に戻します。"
          }
        }
      }
    },
    "actionPictogram.groupsTheFocusedWindowWith" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Groups the focused window with its neighbor so they share one slot."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フォーカス中のウインドウを隣とまとめ、1つの枠を分け合います。"
          }
        }
      }
    },
    "actionPictogram.makesTheFocusedWindowLarger" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Makes the focused window larger / smaller along its split."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "分割の向きに沿って、フォーカス中のウインドウを大きく／小さくします。"
          }
        }
      }
    },
    "actionPictogram.minimizesTheFocusedWindowTo" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minimizes the focused window to the Dock."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フォーカス中のウインドウをDockにしまいます。"
          }
        }
      }
    },
    "actionPictogram.movesTheEdgeBetweenThe" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moves the edge between the focused window and its neighbor."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フォーカス中のウインドウと隣の境目を動かします。"
          }
        }
      }
    },
    "actionPictogram.movesTheFocusToThe" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moves the focus to the neighboring window. Windows stay in place."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "隣のウインドウへフォーカスを移します。ウインドウは動きません。"
          }
        }
      }
    },
    "actionPictogram.movesTheFocusedWindowOne" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moves the focused window one step in the layout. Other windows shift to make room."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フォーカス中のウインドウをレイアウト内で1つ動かします。他のウインドウが詰めます。"
          }
        }
      }
    },
    "actionPictogram.movesTheFocusedWindowTo" : {
      "comment" : "Arguments: 1 = `Copy.desktop(n)`.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moves the focused window to %@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フォーカス中のウインドウを%@へ送ります。"
          }
        }
      }
    },
    "actionPictogram.movesTheFocusedWindowToThe" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moves the focused window to the next / previous Space."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フォーカス中のウインドウを次／前の操作スペースへ送ります。"
          }
        }
      }
    },
    "actionPictogram.newWindowsAreAddedAt" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "New windows are added at the end of the layout."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新しいウインドウはレイアウトの末尾に入ります。"
          }
        }
      }
    },
    "actionPictogram.newWindowsOpenNextTo" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "New windows open next to the focused window."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新しいウインドウはフォーカス中のウインドウの隣に入ります。"
          }
        }
      }
    },
    "actionPictogram.pausesOrResumesArrangingIn" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pauses or resumes arranging in every Space."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべての操作スペースの整列を一時停止・再開します。"
          }
        }
      }
    },
    "actionPictogram.reloadsTheConfigurationFileWindows" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reloads the configuration file. Windows don't move."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "設定ファイルを読み込み直します。ウインドウは動きません。"
          }
        }
      }
    },
    "actionPictogram.resetsTheLayoutsSplitRatios" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resets the layout’s split ratios to equal shares."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "レイアウトの分割比率を均等に戻します。"
          }
        }
      }
    },
    "actionPictogram.returnsTheFocusToThe" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Returns the focus to the previously focused window."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "直前にフォーカスしていたウインドウへ戻ります。"
          }
        }
      }
    },
    "actionPictogram.returnsToTheSpaceYou" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Returns to the Space you used last."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "直前に使った操作スペースに戻ります。"
          }
        }
      }
    },
    "actionPictogram.showsTheNextPreviousSpace" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shows the next / previous Space."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "次／前の操作スペースを表示します。"
          }
        }
      }
    },
    "actionPictogram.showsWindowsStayWhereThey" : {
      "comment" : "Arguments: 1 = `Copy.desktop(n)`.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shows %@. Windows stay where they are."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@を表示します。ウインドウは動きません。"
          }
        }
      }
    },
    "actionPictogram.switchesTheSplitBetweenOverlapping" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Switches the split between overlapping and tiled windows."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "分割内のウインドウを重ねて表示、または並べて表示します。"
          }
        }
      }
    },
    "actionPictogram.switchesTheSplitBetweenSide" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Switches the split between side by side and stacked."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "左右の分割と上下の分割を切り替えます。"
          }
        }
      }
    },
    "actionPictogram.takesTheFocusedWindowOut" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Takes the focused window out of the layout, or puts it back."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フォーカス中のウインドウをレイアウトから外す、または戻します。"
          }
        }
      }
    },
    "actionPictogram.theFocusedWindowTradesPlaces" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The focused window trades places with its neighbor."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フォーカス中のウインドウと隣のウインドウの位置を入れ替えます。"
          }
        }
      }
    },
    "actionPictogram.turnsMacOSFullScreenOn" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turns macOS full screen on or off for the focused window."

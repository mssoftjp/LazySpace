    "settingsWindow.isUsedByItIs" : {
      "comment" : "Arguments: 1 = `key.display`; 2 = `entry`; 3 = `defaultAction`.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ wird von „%@“ verwendet. Es ist auch der Standard für „%@“. Ändere zuerst den Kurzbefehl des Modus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ is used by %@. It is also the default for %@. Change the mode shortcut first."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ lo usa “%@”. También es el valor por omisión de “%@”. Cambia primero el atajo del modo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ est utilisé par « %@ ». C’est aussi la valeur par défaut de « %@ ». Modifiez d’abord le raccourci du mode."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@は「%@」に使われています。「%@」のデフォルトでもあります。先にモードへ入るショートカットを変えてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 키는 ‘%@’에서 사용 중입니다. ‘%@’의 기본값이기도 합니다. 먼저 모드로 전환하는 단축키를 변경하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ é usado por “%@”. Também é o padrão de “%@”. Altere primeiro o atalho que entra no modo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@已被“%2$@”使用，同时也是“%3$@”的默认快捷键。请先更改进入模式的快捷键。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@已用於「%@」，也是「%@」的預設快速鍵。請先更改進入模式的快速鍵。"
          }
        }
      }
    },

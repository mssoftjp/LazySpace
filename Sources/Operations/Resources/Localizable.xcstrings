        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%#@windows@, pero no se recibió a tiempo la lista de ventanas de %2$@, así que no se pudo confirmar el conjunto de ventanas. Vuelve a organizar cuando esa app responda."
          },
          "substitutions" : {
            "windows" : {
              "argNum" : 1,
              "formatSpecifier" : "lld",
              "variations" : {

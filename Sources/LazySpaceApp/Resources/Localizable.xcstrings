    "notifier.lazySpaceStoppedArrangingWindowsBecause" : {
      "comment" : "Arguments: 1 = `AccessPane.name()`.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LazySpace hat das Anordnen der Fenster gestoppt, weil es nicht mehr erlaubt ist. Schalte LazySpace unter Datenschutz & Sicherheit › %@ ein."
          }
        },
        "en" : {
          "stringUnit" : {

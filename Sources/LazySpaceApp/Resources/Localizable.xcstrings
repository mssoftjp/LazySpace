    "settingsWindow.externalChangeMessage" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Datei hat sich geändert. Wähle „Neu laden“, um sie zu laden. Es wurde nichts gesichert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The file changed. Choose Reload to load it. Nothing was saved."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El archivo cambió. Elige “Volver a cargar” para cargarlo. No se guardó nada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le fichier a changé. Choisissez « Recharger » pour le charger. Rien n’a été enregistré."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ファイルが変更されています。「再読み込み」で読み込み直してください。保存していません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "파일이 변경되었습니다. 파일을 로드하려면 ‘다시 로드’를 선택하십시오. 저장된 내용은 없습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O arquivo mudou. Escolha “Recarregar” para carregá-lo. Nada foi salvo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "文件已更改。请选择“重新载入”以载入文件。未存储任何内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "檔案已變更。請選擇「重新載入」以載入檔案。未儲存任何內容。"
          }
        }
      }
    },
    "settingsWindow.fileCaption" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Änderungen an der Datei werden automatisch neu geladen. Beim Sichern einer Änderung hier bleibt eine Sicherungskopie der vorherigen Datei erhalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "File edits reload automatically. Saving a change here keeps a backup of the previous file."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los cambios en el archivo se recargan automáticamente. Al guardar un cambio aquí se conserva una copia del archivo anterior."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les modifications du fichier sont rechargées automatiquement. Enregistrer une modification ici conserve une copie de secours du fichier précédent."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ファイルの変更は自動で反映されます。ここで変更を保存すると、直前のファイルを控えに残します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "파일을 편집하면 자동으로 다시 로드됩니다. 여기에서 변경 사항을 저장하면 이전 파일의 백업이 보관됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As edições no arquivo são recarregadas automaticamente. Salvar uma alteração aqui mantém um backup do arquivo anterior."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "编辑文件后会自动重新载入。在此处存储更改时，会保留之前文件的备份。"

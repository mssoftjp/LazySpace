    "coordinator.thePreviousWindowWasNot" : {
      "comment" : "Arguments: 1 = `name`.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das vorherige Fenster wurde nicht in den Vordergrund geholt, daher bleibt der Fokus auf dem Display „%@“."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The previous window was not brought forward, so focus stays on %@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La ventana anterior no se trajo al frente, así que el foco se queda en %@."

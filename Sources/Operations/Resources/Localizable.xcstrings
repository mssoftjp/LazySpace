                      "state" : "translated",
                      "value" : "%arg windows"
                    }
                  }
                }
              }
            }
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lldつのウインドウを整列しましたが、%2$@がウインドウの一覧を期限内に返さなかったため対象を確定できませんでした。そのアプリが応答するようになってから再度整列してください。"
          }
        }
      }
    },

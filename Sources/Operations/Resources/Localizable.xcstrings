    "arrangeOperation.interruptedTail" : {
      "comment" : "Arguments: 1 = how many windows were checked; 2 = how many were not applied. Inserted into the arrangeOperation.interrupted… entries.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(%1$lld geprüft, %2$lld nicht angewendet; die Fenster bleiben, wo sie jetzt sind)"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(%1$lld checked, %2$lld not applied; windows stay where they are now)"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(comprobadas: %1$lld; sin aplicar: %2$lld; las ventanas se quedan donde están ahora)"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(vérifiées : %1$lld ; non appliquées : %2$lld ; les fenêtres restent où elles sont)"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "（%1$lldつは確認済み、%2$lldつは未適用。位置は現在のまま保ちます）"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(%1$lld개 확인, %2$lld개 적용 안 됨. 윈도우는 현재 위치 유지)"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(verificadas: %1$lld; não aplicadas: %2$lld; as janelas ficam onde estão agora)"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "（已检查%1$lld个，%2$lld个未应用；窗口保持当前位置）"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "（已檢查%1$lld個，未套用%2$lld個；視窗會維持目前的位置）"
          }
        }
      }
    },

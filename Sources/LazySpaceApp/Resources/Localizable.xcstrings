    "cliHelp.waitSettledSeconds" : {
      "comment" : "A command's description in lazyspace help.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf eine frische, stabile Beobachtung des aktuellen Space warten (Standard 5; höchstens 120)"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wait for fresh, stable current-Space observation (default 5; maximum 120)"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esperar una observación nueva y estable del Space actual (por omisión 5; máximo 120)"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attendre une observation récente et stable du Space actuel (par défaut 5 ; maximum 120)"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在の操作スペースを再観測し、安定を待つ（初期値5秒、最大120秒）"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "현재 Space를 새로 관찰하여 안정될 때까지 대기(기본값 5, 최대 120)"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",

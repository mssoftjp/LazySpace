    "nativeShortcutStatus.isAlsoTheMacOSShortcut" : {
      "comment" : "Arguments: 1 = `shown`; 2 = `name`.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ist auch der macOS-Kurzbefehl „%@“. Nach dem Sichern funktioniert das schrittweise Wechseln nach rechts nicht mehr."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ is also the macOS shortcut “%@”. After you save, stepwise switching to the right won't work."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ también es el atajo de macOS “%@”. Después de guardar, el cambio paso a paso hacia la derecha no funcionará."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ est aussi le raccourci macOS « %@ ». Après l’enregistrement, le passage pas à pas vers la droite ne fonctionnera plus."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@はmacOSの「%@」と同じキーです。保存すると、操作スペースを右へ順に切り替えられなくなります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 키는 macOS의 ‘%@’ 단축키와 같습니다. 저장하면 오른쪽으로 Space를 한 단계씩 전환할 수 없게 됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ também é o atalho “%@” do macOS. Depois de salvar, a mudança de Space passo a passo para a direita não vai funcionar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@也是macOS的“%2$@”快捷键。存储后，将无法逐个向右切换空间。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@也是macOS的「%@」快速鍵。儲存後，將無法向右逐一切換空間。"
          }
        }
      }
    },

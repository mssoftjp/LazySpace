    "coordinator.theWindowMovedToBut" : {
      "comment" : "Arguments: 1 = `spaceLabel(dest)`; 2 = `AccessPane.name()`.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Fenster wurde zu %@ bewegt, aber die Berechtigung „%@“ oder die Beobachtung von Maus- und Tastatureingaben ging verloren, daher wurden die Positionskorrektur und die Aufnahme in das Layout abgebrochen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The window moved to %@, but the %@ permission or mouse and keyboard input observation became unavailable, so position correction and adding it to the layout were canceled."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La ventana se movió a %@, pero el permiso “%@” o la observación de la entrada del ratón y el teclado dejaron de estar disponibles, así que se cancelaron la corrección de posición y su adición a la disposición."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La fenêtre est passée à %@, mais l’autorisation « %@ » ou l’observation de la souris et du clavier est devenue indisponible ; la correction de position et l’ajout à la disposition ont donc été annulés."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ウインドウは%@へ移りましたが、「%@」の許可がなくなったか、マウスとキーボードの入力を観測できなくなったため、位置の補正とレイアウトへの追加を中止しました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "윈도우가 %@(으)로 이동했지만 ‘%@’ 권한 또는 마우스 및 키보드 입력 관찰을 사용할 수 없게 되어 위치 보정과 레이아웃 추가를 취소했습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A janela foi para %@, mas a permissão “%@” ou a observação da entrada do mouse e do teclado deixou de estar disponível, por isso a correção da posição e a adição ao layout foram canceladas."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "窗口已移到%1$@，但“%2$@”权限或鼠标和键盘输入观测已不可用，因此已取消位置校正和加入布局。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "視窗已移至%@，但「%@」權限或滑鼠與鍵盤的輸入觀察已無法使用，因此已取消位置修正及加入佈局。"
          }
        }
      }
    },
    "coordinator.theWindowMovedToButInput" : {
      "comment" : "Arguments: 1 = `spaceLabel(dest)`.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Fenster wurde zu %@ bewegt, aber vor dem Ende der Bewegung hat sich eine Eingabe, der Pausenstatus oder der aktuelle Space geändert, daher wurde es nicht in das Layout aufgenommen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The window moved to %@, but input, pause state, or the current Space changed before the move finished, so it was not added to the layout."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La ventana se movió a %@, pero la entrada, el estado de pausa o el Space actual cambiaron antes de terminar el movimiento, así que no se añadió a la disposición."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La fenêtre est passée à %@, mais une saisie, l’état de pause ou le Space actuel a changé avant la fin du déplacement ; elle n’a donc pas été ajoutée à la disposition."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ウインドウは%@へ移りましたが、移動の終わりまでに入力・停止・操作スペースの状態が変わったため、レイアウトには加えていません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "윈도우가 %@(으)로 이동했지만 이동이 끝나기 전에 입력, 일시 정지 상태 또는 현재 Space가 바뀌어 레이아웃에 추가하지 않았습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A janela foi para %@, mas uma entrada, a pausa ou o Space atual mudou antes do fim do movimento, por isso ela não foi adicionada ao layout."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "窗口已移到%@，但在移动完成前输入、暂停状态或当前空间发生了变化，因此未加入布局。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "視窗已移至%@，但在移動完成前輸入、暫停狀態或目前的空間發生變化，因此未加入佈局。"
          }
        }
      }
    },

    "arrangeOperation.arrangedUnobservedLeft" : {
      "comment" : "Arguments: 1 = how many windows were arranged; 2 = the apps that did not answer, joined by copy.listSeparator.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",

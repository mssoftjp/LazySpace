    "windowList.inputObservationIsUnavailableSo" : {
      "comment" : "Arguments: 1 = `AccessPane.name()`.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Eingabebeobachtung ist nicht verfügbar, daher bleibt die automatische Anordnung aus. Öffne die Einstellungen für „%@“ und erlaube LazySpace."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Input observation is unavailable, so automatic arrangement stays off. Open %@ settings and allow LazySpace."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La observación de la entrada no está disponible, así que la organización automática sigue desactivada. Abre los ajustes de “%@” y permite LazySpace."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’observation de la saisie est indisponible ; l’organisation automatique reste donc désactivée. Ouvrez les réglages « %@ » et autorisez LazySpace."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",

          }
        }
      }
    },
    "cliHelp.explicitTargetsBusyAndOther" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auch „beschäftigt“ und andere Ablehnungen bleiben an dieses Token gebunden. Behalte das Token selbst, falls dieser Prozess beendet werden könnte, bevor er es ausgibt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Busy and other refusals stay attached to that token. Keep the token yourself if this process may exit before printing it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los rechazos por ocupado y de otro tipo quedan asociados a ese token. Conserva el token si este proceso puede terminar antes de imprimirlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les refus pour occupation ou autre restent attachés à ce jeton. Conservez le jeton vous-même si ce processus peut se terminer avant de l’afficher."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "処理中や拒否もそのトークンに残ります。プロセスが終了する前にトークンを手元に残してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "처리 중 및 기타 거부도 해당 토큰에 남습니다. 이 프로세스가 토큰을 출력하기 전에 종료될 수 있다면 토큰을 직접 보관하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recusas por ocupado e de outros tipos ficam associadas a esse token. Guarde o token se este processo puder terminar antes de imprimi-lo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "忙碌及其他拒绝结果也会关联到该令牌。如果此进程可能在输出令牌前退出，请自行保存令牌。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "忙碌中和其他拒絕結果也會記錄在該代號下。若此程序可能在印出代號前結束，請自行保留代號。"
          }
        }
      }
    },

    "desktopShortcuts.lazySpaceCouldNotPrepareTo" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LazySpace konnte die Prüfung, ob macOS auf seine Space-Kurzbefehle reagiert, nicht vorbereiten und hat sie daher nicht gesendet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LazySpace could not prepare to check whether macOS responds to its Space shortcuts, so it did not send them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LazySpace no pudo prepararse para comprobar si macOS responde a sus atajos de Space, así que no los envió."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LazySpace n’a pas pu se préparer à vérifier si macOS répond à ses raccourcis de Space ; il ne les a donc pas envoyés."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOSが操作スペースのショートカットに応答するかを確かめる準備ができなかったため、送っていません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS가 Space 단축키에 응답하는지 확인할 준비를 할 수 없어 LazySpace가 단축키를 보내지 않았습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O LazySpace não conseguiu se preparar para verificar se o macOS responde aos atalhos de Space, por isso não os enviou."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LazySpace未能做好检查macOS是否响应空间快捷键的准备，因此未发送这些快捷键。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LazySpace無法準備確認macOS是否回應其空間快速鍵，因此未傳送快速鍵。"
          }
        }
      }
    },

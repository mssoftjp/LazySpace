    "cliHelp.explicitTargetsMoveToSpace" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "move-to-space setzt voraus, dass das Ziel im Vordergrund ist. Kein implizites Fokussieren, kein Space-Wechsel."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Move-to-space requires the target to be in front. No implicit focus or Space changes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "move-to-space requiere que la ventana objetivo esté en primer plano. No cambia el foco ni el Space implícitamente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "move-to-space exige que la cible soit au premier plan. Aucune activation ni changement de Space implicite."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "move-to-spaceは対象が前面の場合のみ。暗黙のフォーカス・操作スペース移動は行いません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "move-to-space는 대상이 앞에 있어야 합니다. 암묵적인 초점 이동이나 Space 변경은 하지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O move-to-space exige que o alvo esteja em primeiro plano. Sem mudanças implícitas de foco ou de Space."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "move-to-space要求目标窗口位于最前面。不会隐式移动焦点或切换空间。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "move-to-space需要目標位於最前方。不會隱含地移動焦點或切換空間。"
          }
        }
      }
    },
    "cliHelp.explicitTargetsRequestIdToken" : {

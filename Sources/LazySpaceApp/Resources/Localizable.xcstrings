    "appMain.lazySpaceAppearsToBeRunning" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LazySpace scheint zu laufen, aber die CLI kann nicht mit der App kommunizieren. Prüfe die Berechtigungen des Ordners „Application Support“ von LazySpace oder versuche es nach dem Start erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LazySpace appears to be running, but CLI communication is unavailable. Check the LazySpace Application Support folder permissions or try again after startup."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LazySpace parece estar en ejecución, pero la comunicación con la CLI no está disponible. Comprueba los permisos de la carpeta Application Support de LazySpace o inténtalo de nuevo cuando termine de abrirse."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LazySpace semble en cours d’exécution, mais la communication avec la CLI est indisponible. Vérifiez les autorisations du dossier Application Support de LazySpace ou réessayez une fois le démarrage terminé."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LazySpaceは起動中のようですが、CLIから通信できません。LazySpaceのApplication Supportフォルダのアクセス権を確認するか、起動完了後に再試行してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LazySpace가 실행 중인 것으로 보이지만 CLI와 통신할 수 없습니다. LazySpace의 Application Support 폴더 권한을 확인하거나 시작이 완료된 후 다시 시도하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O LazySpace parece estar em execução, mas a comunicação com a CLI não está disponível. Verifique as permissões da pasta Application Support do LazySpace ou tente de novo depois da inicialização."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LazySpace似乎正在运行，但无法通过CLI通信。请检查LazySpace的Application Support文件夹的权限，或在启动完成后重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LazySpace似乎正在執行，但無法使用CLI通訊。請檢查LazySpace的Application Support檔案夾權限，或在啟動完成後再試一次。"
          }
        }
      }
    },

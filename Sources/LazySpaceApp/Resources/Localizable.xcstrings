    "settingsWindow.keepsWindowsLikeCalculatorOr" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verhindert, dass Fenster wie der Rechner oder Warnungen hinter anderen Fenstern verschwinden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keeps windows like Calculator or alerts from being hidden behind other windows."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Evita que ventanas como Calculadora o las alertas queden ocultas detrás de otras ventanas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Évite que des fenêtres comme Calculette ou les alertes soient cachées derrière d’autres fenêtres."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "計算機や警告などが、ほかのウインドウで隠れないように並べます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "계산기나 경고 같은 윈도우가 다른 윈도우 뒤에 가려지지 않게 합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Evita que janelas como a Calculadora ou alertas fiquem escondidas atrás de outras janelas."
          }

    "coordinator.checkAndInSystemSettings" : {
      "comment" : "Arguments: 1 = `left`; 2 = `right`.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prüfe „%@“ und „%@“ unter Systemeinstellungen › Tastatur › Tastaturkurzbefehle … › Mission Control."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Check “%@” and “%@” in System Settings › Keyboard › Keyboard Shortcuts… › Mission Control."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comprueba “%@” y “%@” en Ajustes del Sistema › Teclado › Atajos de teclado… › Mission Control."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vérifiez « %@ » et « %@ » dans Réglages Système › Clavier › Raccourcis clavier… › Mission Control."

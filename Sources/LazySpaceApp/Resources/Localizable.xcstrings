    "cliHelp.runTheCLIAs" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Führe die CLI als derselbe angemeldete Benutzer aus, ohne sudo. LAZYSPACE_SUPPORT muss mit der App übereinstimmen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Run the CLI as the same logged-in user, without sudo. LAZYSPACE_SUPPORT must match the app."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ejecuta la CLI como el mismo usuario que inició sesión, sin sudo. LAZYSPACE_SUPPORT debe coincidir con el de la app."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exécutez la CLI avec le même utilisateur connecté, sans sudo. LAZYSPACE_SUPPORT doit correspondre à celui de l’app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CLIはアプリと同じログインユーザーで実行してください（sudo不可）。LAZYSPACE_SUPPORTはアプリと一致させてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CLI는 sudo 없이 앱과 같은 로그인 사용자로 실행하십시오. LAZYSPACE_SUPPORT는 앱과 일치해야 합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Execute a CLI como o mesmo usuário da sessão, sem sudo. LAZYSPACE_SUPPORT precisa coincidir com o do app."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请以与应用相同的已登录用户运行CLI，不要使用sudo。LAZYSPACE_SUPPORT必须与应用一致。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請以相同的登入使用者執行CLI，不要使用sudo。LAZYSPACE_SUPPORT必須與App一致。"
          }
        }
      }
    },

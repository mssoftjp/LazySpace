{
  "sourceLanguage" : "en",
  "strings" : {
    "actionPictogram.addsOneWaitingWindowTo" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nimmt ein wartendes Fenster in das Layout auf."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adds one waiting window to the layout."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade una ventana en espera a la disposición."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoute une fenêtre en attente à la disposition."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "待機中のウインドウを1つレイアウトに加えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "대기 중인 윈도우 1개를 레이아웃에 추가합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adiciona uma janela em espera ao layout."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将一个等待中的窗口加入布局。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將一個等待中的視窗加入佈局。"
          }
        }
      }
    },
    "actionPictogram.arrangesThisSpaceAndStarts" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ordnet diesen Space an und beginnt, ihn als Kacheln anzuordnen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arranges this Space and starts tiling it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Organiza este Space y empieza a colocarlo en mosaico."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Organise ce Space et commence à le disposer en mosaïque."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この操作スペースを整列し、タイル配置を始めます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 Space를 정렬하고 배치를 시작합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Organiza este Space e passa a organizá-lo em mosaico."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "排列此空间并开始平铺。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "排列此空間，然後開始並排其中的視窗。"
          }
        }
      }
    },
    "actionPictogram.closesTheFocusedWindow" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schließt das fokussierte Fenster."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Closes the focused window."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cierra la ventana activa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ferme la fenêtre active."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フォーカス中のウインドウを閉じます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "초점이 있는 윈도우를 닫습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fecha a janela em foco."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "关闭焦点窗口。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "關閉焦點視窗。"
          }
        }
      }
    },
    "actionPictogram.fillsTheWorkAreaWith" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füllt den Arbeitsbereich mit dem fokussierten Fenster oder stellt das Kachel-Layout wieder her."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fills the work area with the focused window, or restores the tiled layout."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rellena el área de trabajo con la ventana activa o restaura la disposición en mosaico."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remplit la zone de travail avec la fenêtre active, ou rétablit la disposition en mosaïque."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フォーカス中のウインドウを作業領域いっぱいに広げる、または整列した表示に戻します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "초점이 있는 윈도우로 작업 영역을 채우거나, 배치된 레이아웃으로 되돌립니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Preenche a área útil com a janela em foco ou restaura o layout em mosaico."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "让焦点窗口填满工作区域，或恢复平铺布局。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "讓焦點視窗填滿工作區域，或回復並排的佈局。"
          }
        }
      }
    },
    "actionPictogram.groupsTheFocusedWindowWith" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gruppiert das fokussierte Fenster mit seinem Nachbarn, sodass sie sich einen Platz teilen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Groups the focused window with its neighbor so they share one slot."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agrupa la ventana activa con su vecina para que compartan una posición."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Groupe la fenêtre active avec sa voisine pour qu’elles partagent un seul emplacement."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フォーカス中のウインドウを隣とまとめ、1つの枠を分け合います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "초점이 있는 윈도우를 옆 윈도우와 그룹화하여 하나의 자리를 함께 사용합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agrupa a janela em foco com a vizinha para que compartilhem uma posição."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将焦点窗口与相邻窗口分组，共用一个位置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將焦點視窗與相鄰的視窗分組，共用一個位置。"
          }
        }
      }
    },
    "actionPictogram.makesTheFocusedWindowLarger" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vergrößert / verkleinert das fokussierte Fenster entlang seiner Teilung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Makes the focused window larger / smaller along its split."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agranda / reduce la ventana activa a lo largo de su división."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agrandit / réduit la fenêtre active dans le sens de sa division."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "分割の向きに沿って、フォーカス中のウインドウを大きく／小さくします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "분할 방향을 따라 초점이 있는 윈도우를 크게 / 작게 만듭니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aumenta / reduz a janela em foco ao longo da sua divisão."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "沿分割方向调大或调小焦点窗口。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "沿著分割的方向，讓焦點視窗變大/變小。"
          }
        }
      }
    },
    "actionPictogram.minimizesTheFocusedWindowTo" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legt das fokussierte Fenster im Dock ab."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minimizes the focused window to the Dock."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minimiza la ventana activa en el Dock."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minimise la fenêtre active dans le Dock."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フォーカス中のウインドウをDockにしまいます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "초점이 있는 윈도우를 Dock으로 최소화합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minimiza a janela em foco no Dock."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将焦点窗口最小化到程序坞。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將焦點視窗縮到最小並收進Dock。"
          }
        }
      }
    },
    "actionPictogram.movesTheEdgeBetweenThe" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verschiebt die Kante zwischen dem fokussierten Fenster und seinem Nachbarn."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moves the edge between the focused window and its neighbor."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mueve la separación entre la ventana activa y su vecina."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Déplace la limite entre la fenêtre active et sa voisine."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フォーカス中のウインドウと隣の境目を動かします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "초점이 있는 윈도우와 옆 윈도우 사이의 경계를 이동합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Move o limite entre a janela em foco e a vizinha."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "移动焦点窗口与相邻窗口之间的边界。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "移動焦點視窗與相鄰視窗之間的邊界。"
          }
        }
      }
    },
    "actionPictogram.movesTheFocusToThe" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fokussiert das Nachbarfenster. Die Fenster bleiben, wo sie sind."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moves the focus to the neighboring window. Windows stay in place."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activa la ventana vecina. Las ventanas no se mueven."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Active la fenêtre voisine. Les fenêtres restent en place."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "隣のウインドウへフォーカスを移します。ウインドウは動きません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "옆 윈도우로 초점을 이동합니다. 윈도우는 움직이지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Move o foco para a janela vizinha. As janelas ficam onde estão."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将焦点移到相邻窗口。窗口位置不变。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "移動焦點至相鄰的視窗。視窗不會移動。"
          }
        }
      }
    },
    "actionPictogram.movesTheFocusedWindowOne" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bewegt das fokussierte Fenster im Layout um einen Schritt. Die anderen Fenster rücken nach."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moves the focused window one step in the layout. Other windows shift to make room."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mueve la ventana activa un paso en la disposición. Las demás ventanas se desplazan para dejarle lugar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Déplace la fenêtre active d’un cran dans la disposition. Les autres fenêtres se décalent pour lui faire de la place."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フォーカス中のウインドウをレイアウト内で1つ動かします。他のウインドウが詰めます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "레이아웃에서 초점이 있는 윈도우를 한 칸 이동합니다. 다른 윈도우는 그에 맞춰 자리를 옮깁니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Move a janela em foco um passo no layout. As outras janelas se deslocam para dar lugar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将焦点窗口在布局中移动一个位置。其他窗口随之挪动，让出位置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在佈局中將焦點視窗移動一格。其他視窗會隨之挪動。"
          }
        }
      }
    },
    "actionPictogram.movesTheFocusedWindowTo" : {
      "comment" : "Arguments: 1 = `Copy.desktop(n)`.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bewegt das fokussierte Fenster zu %@."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moves the focused window to %@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mueve la ventana activa a %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Déplace la fenêtre active vers %@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フォーカス中のウインドウを%@へ送ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "초점이 있는 윈도우를 %@(으)로 이동합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Move a janela em foco para %@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将焦点窗口移到%@。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將焦點視窗移至%@。"
          }
        }
      }
    },
    "actionPictogram.movesTheFocusedWindowToThe" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bewegt das fokussierte Fenster zum nächsten / vorherigen Space."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moves the focused window to the next / previous Space."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mueve la ventana activa al Space siguiente / anterior."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Déplace la fenêtre active vers le Space suivant / précédent."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フォーカス中のウインドウを次／前の操作スペースへ送ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "초점이 있는 윈도우를 다음 / 이전 Space로 이동합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Move a janela em foco para o Space seguinte / anterior."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将焦点窗口移到下一个或上一个空间。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將焦點視窗移至下一個/上一個空間。"
          }
        }
      }
    },
    "actionPictogram.newWindowsAreAddedAt" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neue Fenster kommen ans Ende des Layouts."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "New windows are added at the end of the layout."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las ventanas nuevas se añaden al final de la disposición."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les nouvelles fenêtres sont ajoutées à la fin de la disposition."
          }
        },
        "ja" : {

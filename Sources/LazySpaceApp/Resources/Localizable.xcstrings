        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "저장하면 %@이(가) 제거되어 이 충돌이 해결됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ao salvar, %@ é removido, por isso este conflito desaparece."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "存储后会移除%@，此冲突随之消除。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "儲存後會移除%@，此衝突即會解除。"

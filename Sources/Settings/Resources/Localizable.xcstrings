        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "keys.%@: mainモードでは修飾キーなしの%@は通常の入力を横取りするため使えません。Fキーかモード内なら使えます。"
          }
        }
      }
    },

        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "After the move request, the window belongs to several Spaces (%@). Where it ended up could not be determined."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tras la solicitud de movimiento, la ventana pertenece a varios Spaces (%@). No se pudo determinar dónde quedó."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Après la demande de déplacement, la fenêtre appartient à plusieurs Spaces (%@). Impossible de déterminer où elle a abouti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "移動の要求のあと、ウインドウは複数の操作スペース（%@）に属しています。どこに着いたかは判断できません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이동 요청 후 윈도우가 여러 Space(%@)에 속해 있습니다. 윈도우가 어디로 이동했는지 판단할 수 없습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Depois da solicitação de movimento, a janela pertence a vários Spaces (%@). Não foi possível determinar onde ela ficou."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "发出移动请求后，窗口属于多个空间（%@）。无法确定窗口最终所在的空间。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要求移動後，視窗屬於多個空間（%@）。無法確定其最終位置。"
          }
        }
      }
    },
    "coordinator.pausedInAllSpacesResuming" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In allen Spaces angehalten. Das Fortsetzen allein bewegt keine Fenster; die automatische Anordnung kann danach weiterlaufen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paused in all Spaces. Resuming does not itself move windows; automatic arrangement can continue afterward."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En pausa en todos los Spaces. Reanudar no mueve ventanas por sí mismo; la organización automática puede continuar después."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En pause dans tous les Spaces. La reprise ne déplace pas de fenêtre par elle-même ; l’organisation automatique peut continuer ensuite."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべての操作スペースで一時停止中です。再開の操作だけではウインドウは動きません。再開後は自動整列を続けられます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 Space에서 일시 정지 중입니다. 재개 자체로는 윈도우가 이동하지 않으며, 재개 후 자동 정렬을 계속할 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Em pausa em todos os Spaces. Retomar, por si só, não move janelas; a organização automática pode continuar depois."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已在所有空间暂停。继续本身不会移动窗口；之后自动排列可以继续进行。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所有空間皆已暫停。繼續本身不會移動視窗；之後可繼續自動排列。"
          }
        }
      }
    },
    "coordinator.pausedUnresponsive" : {
      "comment" : "Arguments: 1 = the apps, joined by copy.listSeparator; 2 = the menu item that resumes; 3 = how many apps (chooses it or they).",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle Spaces bleiben angehalten, weil von %1$@ keine Antwort kam und das aktuelle Fenster-Layout daher nicht bestätigt werden konnte. Wähle „%2$@“ erneut, %#@apps@."
          },
          "substitutions" : {
            "apps" : {
              "argNum" : 3,
              "formatSpecifier" : "lld",
              "variations" : {
                "plural" : {
                  "one" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "sobald die App antwortet, oder beende sie"
                    }
                  },
                  "other" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "sobald die Apps antworten, oder beende sie"
                    }
                  }
                }
              }
            }
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "All Spaces remain paused because %1$@ did not respond, so the current window layout could not be confirmed. Choose %2$@ again %#@apps@."
          },
          "substitutions" : {
            "apps" : {
              "argNum" : 3,
              "formatSpecifier" : "lld",
              "variations" : {
                "plural" : {
                  "one" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "when it responds, or quit it"
                    }
                  },
                  "other" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "when they respond, or quit them"
                    }
                  }
                }
              }
            }
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todos los Spaces siguen en pausa porque no hubo respuesta de %1$@, así que no se pudo confirmar la disposición actual de las ventanas. Elige “%2$@” de nuevo %#@apps@."
          },
          "substitutions" : {
            "apps" : {
              "argNum" : 3,
              "formatSpecifier" : "lld",
              "variations" : {
                "plural" : {
                  "one" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "cuando responda, o sal de la app"
                    }
                  },
                  "other" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "cuando respondan, o sal de ellas"
                    }
                  }
                }
              }
            }
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tous les Spaces restent en pause : la disposition actuelle des fenêtres n’a pas pu être confirmée (%1$@ : pas de réponse). Choisissez de nouveau « %2$@ » %#@apps@."
          },
          "substitutions" : {
            "apps" : {
              "argNum" : 3,
              "formatSpecifier" : "lld",
              "variations" : {
                "plural" : {
                  "one" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "quand cette app répondra, ou quittez-la"
                    }
                  },
                  "other" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "quand ces apps répondront, ou quittez-les"
                    }
                  }
                }
              }
            }
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@が応答しないため現在のウインドウ配置を確認できず、一時停止を続けています。応答してから「%2$@」をもう一度選ぶか、終了してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 앱이 응답하지 않아 현재 윈도우 레이아웃을 확인할 수 없으므로 모든 Space가 일시 정지된 상태입니다. 앱이 응답하면 ‘%2$@’을(를) 다시 선택하거나 앱을 종료하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todos os Spaces continuam em pausa porque %1$@ não respondeu, por isso o layout atual das janelas não pôde ser confirmado. Escolha “%2$@” de novo %#@apps@."
          },
          "substitutions" : {
            "apps" : {
              "argNum" : 3,
              "formatSpecifier" : "lld",
              "variations" : {
                "plural" : {
                  "one" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "quando ele responder, ou encerre-o"
                    }
                  },
                  "other" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "quando eles responderem, ou encerre-os"
                    }
                  }
                }
              }
            }
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@没有响应，因此无法确认当前窗口布局，所有空间仍处于暂停状态。请在应用响应后再次选择“%2$@”，或退出应用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "由於%1$@沒有回應，無法確認目前的視窗佈局，因此所有空間仍維持暫停。請在其回應後再次選擇「%2$@」，或將其結束。"
          }
        }
      }
    },

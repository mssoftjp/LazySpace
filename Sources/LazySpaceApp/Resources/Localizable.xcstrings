    "coordinator.stoppedAfterTheRequestTo" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nach der Anfrage, das Fenster zu senden, wegen einer Eingabe, des Anhaltens oder eines Abbruchs gestoppt. Das Fenster kann sich noch bewegen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stopped after the request to send the window was made, because of input, pausing or cancellation. The window may still move."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se detuvo después de solicitar el envío de la ventana, por una entrada, una pausa o una cancelación. La ventana aún puede moverse."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrêt après la demande d’envoi de la fenêtre, à cause d’une saisie, d’une mise en pause ou d’une annulation. La fenêtre peut encore bouger."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ウインドウを送る要求のあと、入力・停止・取消のため確認をやめました。ウインドウがあとで移ることがあります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "윈도우를 보내도록 요청한 후 입력, 일시 정지 또는 취소로 인해 중단했습니다. 윈도우가 나중에 이동할 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Interrompido depois da solicitação de envio da janela, por causa de uma entrada, da pausa ou de um cancelamento. A janela ainda pode se mover."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "发出移动窗口的请求后，由于输入、暂停或取消而停止。窗口仍可能移动。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已送出傳送視窗的要求，但因輸入、暫停或取消而停止。視窗仍可能移動。"
          }
        }
      }
    },

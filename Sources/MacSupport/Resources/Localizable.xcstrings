          }
        }
      }
    },
    "macWindowSystem.stoppedBecauseTheSpaceThe" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gestoppt, weil sich der Space, das Fenster, eine Eingabe oder das Zeitlimit geändert hat."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stopped because the Space, the window, input, or the time limit changed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se detuvo porque cambiaron el Space, la ventana, la entrada o el límite de tiempo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrêt parce que le Space, la fenêtre, une saisie ou la limite de temps a changé."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "操作スペース・ウインドウ・入力・時間の条件が変わったため中止しました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Space, 윈도우, 입력 또는 시간 제한 조건이 바뀌어 중단했습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Interrompido porque o Space, a janela, a entrada ou o limite de tempo mudou."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "空间、窗口、输入或时间限制发生了变化，因此已停止。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "由於空間、視窗、輸入或時間限制發生變化，因此已停止。"
          }
        }
      }
    },
    "macWindowSystem.theOperationWasInterruptedBefore" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",

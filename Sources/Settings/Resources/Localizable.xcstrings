    "configDocument.settingsCantFindAValue" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Einstellungen finden keinen Wert, der ersetzt werden kann. Bearbeite die Datei und wähle dann „Neu laden“. Es wurde nichts gesichert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Settings can't find a value to replace. Edit the file, then choose Reload. Nothing was saved."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajustes no encuentra ningún valor que sustituir. Edita el archivo y luego elige “Volver a cargar”. No se guardó nada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les Réglages ne trouvent pas de valeur à remplacer. Modifiez le fichier, puis choisissez « Recharger ». Rien n’a été enregistré."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "置き換える値が見つかりません。ファイルを編集してから「再読み込み」を選んでください。保存していません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "설정에서 바꿀 값을 찾을 수 없습니다. 파일을 편집한 다음 ‘다시 로드’를 선택하십시오. 저장된 내용은 없습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os Ajustes não encontram um valor para substituir. Edite o arquivo e escolha “Recarregar”. Nada foi salvo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "设置窗口找不到要替换的值。请编辑文件，然后选择“重新载入”。未存储任何内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「設定」找不到要取代的值。請編輯檔案，然後選擇「重新載入」。未儲存任何內容。"
          }
        }
      }
    },
    "configDocument.settingsCantUpdateEntriesWritten" : {
      "comment" : "Arguments: 1 = `label`.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Einstellungen können Einträge für %@ in dieser Schreibweise nicht aktualisieren. Bearbeite sie in der Datei und wähle dann „Neu laden“. Es wurde nichts gesichert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Settings can't update %@ entries written in this form. Edit them in the file, then choose Reload. Nothing was saved."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajustes no puede actualizar las entradas de %@ escritas de esta forma. Edítalas en el archivo y luego elige “Volver a cargar”. No se guardó nada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les Réglages ne peuvent pas mettre à jour des entrées %@ écrites sous cette forme. Modifiez-les dans le fichier, puis choisissez « Recharger ». Rien n’a été enregistré."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@がこの書き方だと更新できません。ファイルで編集してから「再読み込み」を選んでください。保存していません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 형식으로 작성된 %@ 항목은 설정에서 업데이트할 수 없습니다. 파일에서 편집한 다음 ‘다시 로드’를 선택하십시오. 저장된 내용은 없습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os Ajustes não conseguem atualizar entradas de %@ escritas desta forma. Edite-as no arquivo e escolha “Recarregar”. Nada foi salvo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "设置窗口无法更新以此形式写入的%@条目。请在文件中编辑这些条目，然后选择“重新载入”。未存储任何内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「設定」無法更新以此形式寫入的%@項目。請在檔案中編輯，然後選擇「重新載入」。未儲存任何內容。"
          }
        }
      }
    },
    "configDocument.settingsCantUpdateGapsWritten" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Einstellungen können gaps nicht aktualisieren, wenn es als Inline-Tabelle geschrieben ist. Bearbeite die Tabelle [gaps] in der Datei und wähle dann „Neu laden“. Es wurde nichts gesichert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Settings can't update gaps written as an inline table. Edit the [gaps] table in the file, then choose Reload. Nothing was saved."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajustes no puede actualizar gaps escrito como tabla en línea. Edita la tabla [gaps] en el archivo y luego elige “Volver a cargar”. No se guardó nada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les Réglages ne peuvent pas mettre à jour gaps écrit sous forme de table en ligne. Modifiez la table [gaps] dans le fichier, puis choisissez « Recharger ». Rien n’a été enregistré."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "隙間がインラインテーブルで書かれているため更新できません。ファイルの[gaps]を編集してから「再読み込み」を選んでください。保存していません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "인라인 테이블로 작성된 gaps는 설정에서 업데이트할 수 없습니다. 파일에서 [gaps] 테이블을 편집한 다음 ‘다시 로드’를 선택하십시오. 저장된 내용은 없습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os Ajustes não conseguem atualizar gaps escrito como tabela inline. Edite a tabela [gaps] no arquivo e escolha “Recarregar”. Nada foi salvo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "gaps以内联表形式写入，设置窗口无法更新。请编辑文件中的[gaps]表，然后选择“重新载入”。未存储任何内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「設定」無法更新寫成行內表格的gaps。請編輯檔案中的[gaps]表格，然後選擇「重新載入」。未儲存任何內容。"
          }
        }
      }
    },
    "configDocument.settingsCantUpdateLineBecause" : {
      "comment" : "Arguments: 1 = `index + 1`.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Einstellungen können Zeile %@ nicht aktualisieren, weil sie nicht genau einen Schlüssel und einen Wert enthält. Bearbeite die Datei und wähle dann „Neu laden“. Es wurde nichts gesichert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Settings can't update line %@ because it is not a single key and value. Edit the file, then choose Reload. Nothing was saved."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajustes no puede actualizar la línea %@ porque no es una sola clave con su valor. Edita el archivo y luego elige “Volver a cargar”. No se guardó nada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les Réglages ne peuvent pas mettre à jour la ligne %@, car elle ne contient pas une seule clé et une seule valeur. Modifiez le fichier, puis choisissez « Recharger ». Rien n’a été enregistré."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@行目は一つのキーと値ではないため更新できません。ファイルを編集してから「再読み込み」を選んでください。保存していません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@번째 줄은 단일 키와 값이 아니므로 설정에서 업데이트할 수 없습니다. 파일을 편집한 다음 ‘다시 로드’를 선택하십시오. 저장된 내용은 없습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os Ajustes não conseguem atualizar a linha %@ porque ela não é uma única chave com valor. Edite o arquivo e escolha “Recarregar”. Nada foi salvo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "第%@行不是单个键和值，因此设置窗口无法更新该行。请编辑文件，然后选择“重新载入”。未存储任何内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "第%@行不是單一的鍵與值，因此「設定」無法更新。請編輯檔案，然後選擇「重新載入」。未儲存任何內容。"
          }
        }
      }
    },

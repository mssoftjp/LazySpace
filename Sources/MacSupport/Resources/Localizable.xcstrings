{
  "sourceLanguage" : "en",
  "strings" : {
    "dockShortcutFreshness.message" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keyboard shortcut preferences were saved after the Dock started. If a Mission Control shortcut does not respond, restarting the Dock (Terminal: killall Dock) or logging out and in may help."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dockの起動後にキーボードショートカットの設定が保存されています。Mission Controlのショートカットが応答しないときは、Dockの再起動（ターミナルで`killall Dock`）かログアウトで直ることがあります。"
          }
        }
      }
    },
    "macWindowSystem.couldNotReadTheWindow" : {
      "comment" : "Arguments: 1 = `e.label`.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Could not read the window attribute: %@"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ウインドウの属性を読めません: %@"
          }
        }
      }
    },

    "coordinator.aNewWindowMayNot" : {
      "comment" : "Arguments: 1 = `spaceLabel(dest)`.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein neues Fenster hat %@ möglicherweise nicht erreicht; LazySpace lässt es in Ruhe, bis sein Space bekannt ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A new window may not have reached %@; LazySpace leaves it alone until its Space is known."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puede que una ventana nueva no haya llegado a %@; LazySpace no la toca hasta conocer su Space."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une nouvelle fenêtre n’a peut-être pas atteint %@ ; LazySpace n’y touche pas tant que son Space n’est pas connu."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新しいウインドウが%@に届いたか確かめられません。所属が分かるまで、このウインドウには書き込みません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "새 윈도우가 %@에 도달하지 않았을 수 있습니다. 소속 Space를 알 수 있을 때까지 LazySpace는 이 윈도우를 그대로 둡니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma janela nova pode não ter chegado a %@; o LazySpace não mexe nela até saber o Space dela."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新窗口可能尚未到达%@；在确定其所在空间之前，LazySpace不会处理它。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新視窗可能尚未到達%@；在確認其所屬空間之前，LazySpace不會處理它。"
          }
        }
      }
    },
    "coordinator.aNewWindowWasNot" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein neues Fenster wurde wegen des Anhaltens, einer Eingabe oder eines Space-Wechsels noch nicht gesendet; es wird kurz darauf erneut versucht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A new window was not sent yet because of the pause state, input, or a Space change; it is tried again for a moment."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una ventana nueva aún no se envió por el estado de pausa, una entrada o un cambio de Space; se vuelve a intentar durante un momento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une nouvelle fenêtre n’a pas encore été envoyée à cause de la pause, d’une saisie ou d’un changement de Space ; nouvel essai pendant un moment."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "停止・入力・操作スペースの変化のため、新しいウインドウはまだ送っていません。しばらく試し直します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "일시 정지 상태, 입력 또는 Space 변경으로 인해 새 윈도우를 아직 보내지 않았습니다. 잠시 동안 다시 시도합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma janela nova ainda não foi enviada por causa da pausa, de uma entrada ou de uma mudança de Space; a tentativa se repete por um momento."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "由于暂停状态、输入或空间变化，新窗口尚未移动；将在短时间内重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "由於暫停狀態、輸入或空間變更，新視窗尚未傳送；稍後會短暫重試。"
          }
        }
      }
    },

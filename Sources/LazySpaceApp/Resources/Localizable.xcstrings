        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "윈도우 편집 명령어에서 사용할 수 있습니다. --window-id를 생략하면 초점이 있는 윈도우가 사용됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",

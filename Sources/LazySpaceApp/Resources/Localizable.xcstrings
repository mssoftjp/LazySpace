    },
    "cliHelp.exitCodesWithExit2" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei Exit-Code 2 bedeutet control-unavailable, dass die Instanzsperre der App gehalten wird, die CLI-Kommunikation aber fehlgeschlagen ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "With exit 2, code control-unavailable means the app instance lock is held but CLI communication failed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con el código de salida 2, el código control-unavailable indica que el bloqueo de instancia de la app está tomado pero la comunicación con la CLI falló."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avec le code de sortie 2, le code control-unavailable signifie que le verrou d’instance de l’app est détenu mais que la communication avec la CLI a échoué."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "終了コード2のcontrol-unavailableは、アプリの起動ロックが保持されているがCLI通信に失敗したことを示します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "종료 코드 2에서 control-unavailable 코드는 앱 인스턴스 잠금은 유지되고 있지만 CLI 통신이 실패했음을 의미합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Com saída 2, o código control-unavailable significa que o bloqueio da instância do app está retido, mas a comunicação com a CLI falhou."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "退出码为2时，代码control-unavailable表示应用实例锁已被持有，但CLI通信失败。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "結束代碼為2時，代碼control-unavailable表示App的執行個體鎖定仍被持有，但CLI通訊失敗。"
          }
        }
      }
    },
    "cliHelp.explicitTargetsAvailableOnWindow" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verfügbar bei Befehlen, die Fenster bearbeiten. Ohne --window-id wird das fokussierte Fenster verwendet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Available on window editing commands. Without --window-id, the focused window is used."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disponible en los comandos que editan ventanas. Sin --window-id, se usa la ventana activa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disponible sur les commandes d’édition de fenêtre. Sans --window-id, la fenêtre active est utilisée."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ウインドウ編集で利用できます。window-idを省略するとフォーカス中のウインドウが対象です。"
          }

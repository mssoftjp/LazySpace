    "nativeShortcutStatus.macOSIsNotRespondingTo" : {
      "comment" : "Arguments: 1 = `name`.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS reagiert nicht auf „%@“, daher funktioniert das schrittweise Wechseln des Space nach rechts nicht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS is not responding to “%@”, so stepwise Space switching to the right won't work."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS no responde a “%@”, así que el cambio de Space paso a paso hacia la derecha no funcionará."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS ne répond pas à « %@ » ; le passage pas à pas vers le Space de droite ne fonctionnera pas."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOSが「%@」に応答しないため、操作スペースを右へ順に切り替えられません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS가 ‘%@’에 응답하지 않아 오른쪽으로 Space를 한 단계씩 전환할 수 없습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O macOS não está respondendo a “%@”, por isso a mudança de Space passo a passo para a direita não vai funcionar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS没有响应“%@”，因此无法逐个向右切换空间。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS沒有回應「%@」，因此無法向右逐一切換空間。"
          }
        }
      }
    },

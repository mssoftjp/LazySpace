    "coordinator.theWindowEndedUpOn" : {
      "comment" : "Arguments: 1 = `spaceLabel(to)`.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Fenster ist auf %@ gelandet, nicht im Ziel-Space. Die Ursache konnte nicht ermittelt werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The window ended up on %@, not the target Space. The cause could not be determined."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La ventana quedó en %@, no en el Space de destino. No se pudo determinar la causa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La fenêtre a abouti sur %@, pas sur le Space cible. La cause n’a pas pu être déterminée."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ウインドウは%@にありました（目標とは別の操作スペース）。移動先が変わった原因は確認できていません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "윈도우가 대상 Space가 아닌 %@(으)로 이동했습니다. 원인을 확인할 수 없습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A janela acabou em %@, não no Space de destino. Não foi possível determinar a causa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "窗口最终位于%@，而不是目标空间。无法确定原因。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "視窗最終位於%@，而非目標空間。無法確定原因。"
          }
        }
      }
    },

    "config.keysNeedsAModifierKey" : {
      "comment" : "Arguments: 1 = `name`; 2 = `key.display`.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "keys.%@: %@ needs a modifier key in the main mode because a single key would capture normal typing. Single keys are allowed for function keys or inside a mode."

    "settingsWindow.notificationCaption" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn das Anordnen stoppt, bis du eingreifst, oder eine Änderung an der Konfigurationsdatei nicht angewendet werden kann. Wie Mitteilungen erscheinen, wählst du unter Systemeinstellungen › Mitteilungen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When arranging stops until you act, or a change to the configuration file can’t be applied. Choose how notifications appear in System Settings › Notifications."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando la organización se detiene hasta que actúes, o cuando un cambio en el archivo de configuración no se puede aplicar. Elige cómo aparecen las notificaciones en Ajustes del Sistema › Notificaciones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quand l’organisation s’arrête jusqu’à ce que vous agissiez, ou qu’une modification du fichier de configuration ne peut pas être appliquée. Choisissez l’apparence des notifications dans Réglages Système › Notifications."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "対処するまで整列が止まるときや、設定ファイルの変更を適用できないときに通知します。表示のしかたはシステム設定 › 通知で選べます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "조치할 때까지 정렬이 중단되거나 설정 파일의 변경 사항을 적용할 수 없을 때 알립니다. 알림 표시 방식은 시스템 설정 › 알림에서 선택하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando a organização para até você agir ou quando uma alteração no arquivo de configuração não pode ser aplicada. Escolha como as notificações aparecem em Ajustes do Sistema › Notificações."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在排列停止并等待处理，或无法应用配置文件的更改时通知。可在系统设置 › 通知中选择通知的显示方式。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在排列停止並需要你處理，或無法套用設定檔的變更時通知。你可以在「系統設定」›「通知」中選擇通知的顯示方式。"
          }
        }
      }
    },
    "settingsWindow.notificationsDenied" : {

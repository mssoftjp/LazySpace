          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이전 윈도우를 앞으로 가져오지 않았으므로 초점이 ‘%@’ 디스플레이에 남아 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A janela anterior não foi trazida para a frente, por isso o foco continua em %@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "之前的窗口未移到前面，因此焦点仍在显示器“%@”上。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未將先前的視窗移至最前方，因此焦點仍停留在顯示器「%@」。"
          }
        }
      }
    },

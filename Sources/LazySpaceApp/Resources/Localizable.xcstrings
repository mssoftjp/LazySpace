    "coordinator.theFocusedWindowIsFloating" : {
      "comment" : "Arguments: 1 = `display`.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das fokussierte Fenster schwebt. Drücke %@, um es in das Layout zurückzuholen, und versuche es dann erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The focused window is floating. Press %@ to return it to the layout, then try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La ventana activa es flotante. Pulsa %@ para devolverla a la disposición e inténtalo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La fenêtre active est flottante. Appuyez sur %@ pour la remettre dans la disposition, puis réessayez."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フォーカス中のウインドウはフローティングです。%@でレイアウトに戻してから操作してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "초점이 있는 윈도우가 플로팅 상태입니다. %@ 키를 눌러 레이아웃으로 되돌린 다음 다시 시도하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A janela em foco está flutuante. Pressione %@ para devolvê-la ao layout e tente de novo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "焦点窗口处于浮动状态。请按下%@将其放回布局，然后重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "焦點視窗為浮動狀態。請按下%@將其放回佈局，然後再試一次。"
          }
        }
      }
    },

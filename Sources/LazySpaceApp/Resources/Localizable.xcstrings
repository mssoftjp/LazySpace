    "coordinator.waitingToStartThisSpace" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wartet auf den Start. Dieser Space beginnt mit dem Anordnen als Kacheln ab einem einbezogenen fokussierten Fenster, sobald du in ihm bleibst und die Eingaben zur Ruhe kommen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Waiting to start. This Space starts tiling from an eligible focused window after you stay on it and input settles."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esperando para empezar. Este Space empezará a colocarse en mosaico a partir de una ventana activa incluida cuando permanezcas en él y la entrada se estabilice."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En attente de démarrage. Quand vous restez sur ce Space et que la saisie se calme, LazySpace commence à le disposer en mosaïque à partir d’une fenêtre active incluse."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "開始待ちです。この操作スペースに留まり、入力が落ち着くと、フォーカス中の対象ウインドウから整列を始めます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시작 대기 중입니다. 이 Space에 머물러 입력이 안정되면 초점이 있는 정렬 대상 윈도우부터 배치를 시작합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aguardando início. A organização em mosaico deste Space começa a partir de uma janela em foco incluída depois que você permanecer nele e a entrada se estabilizar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "等待开始。停留在此空间且输入稳定后，将从可排列的焦点窗口开始平铺此空间。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "等待開始。停留在此空間且輸入穩定後，會從可排列的焦點視窗開始並排此空間。"
          }
        }
      }
    },

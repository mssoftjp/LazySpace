    "arrangeOperation.arrangedUnobservedUnconfirmed" : {
      "comment" : "Arguments: 1 = how many windows were arranged; 2 = the apps that did not answer, joined by copy.listSeparator.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%#@windows@ angeordnet, aber von %2$@ kam nicht rechtzeitig eine Fensterliste, daher konnte die Menge der Fenster nicht bestätigt werden. Ordne erneut an, sobald eine Antwort kommt."
          },
          "substitutions" : {
            "windows" : {
              "argNum" : 1,
              "formatSpecifier" : "lld",
              "variations" : {

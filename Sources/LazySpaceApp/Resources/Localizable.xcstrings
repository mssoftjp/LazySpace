    "windowList.theCurrentSpaceCantBe" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der aktuelle Space kann nicht erkannt werden. Diese macOS-Version teilt LazySpace nicht mit, welcher Space aktiv ist, daher können die Fenster in diesem Space nicht aufgelistet werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The current Space can't be detected. This version of macOS does not tell LazySpace which Space is active, so windows in this Space can't be listed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se puede detectar el Space actual. Esta versión de macOS no indica a LazySpace qué Space está activo, así que no se pueden mostrar las ventanas de este Space."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le Space actuel ne peut pas être détecté. Cette version de macOS n’indique pas à LazySpace quel Space est actif ; les fenêtres de ce Space ne peuvent donc pas être listées."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在の操作スペースを確認できません。このmacOSでは現在の操作スペースが分からないため、この操作スペースのウインドウを一覧できません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "현재 Space를 감지할 수 없습니다. 이 버전의 macOS는 어느 Space가 활성 상태인지 LazySpace에 알려 주지 않으므로 이 Space의 윈도우를 나열할 수 없습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não é possível detectar o Space atual. Esta versão do macOS não informa ao LazySpace qual Space está ativo, por isso as janelas deste Space não podem ser listadas."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法检测当前空间。此版本的macOS不会告知LazySpace哪个空间处于活跃状态，因此无法列出此空间中的窗口。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法偵測目前的空間。此版本的macOS不會告知LazySpace目前使用中的空間，因此無法列出此空間中的視窗。"
          }
        }
      }
    },
    "windowList.thePermissionIsRequiredTo" : {
      "comment" : "Arguments: 1 = `AccessPane.name()`.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zum Lesen der Fenster ist die Berechtigung „%@“ erforderlich. Öffne die Einstellungen „Allgemein“ und klicke auf „Systemeinstellungen öffnen …“."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The %@ permission is required to read windows. Open General Settings and click Open System Settings…."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se necesita el permiso “%@” para leer las ventanas. Abre “General” en Ajustes y haz clic en “Abrir Ajustes del Sistema…”."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’autorisation « %@ » est requise pour lire les fenêtres. Ouvrez « Général » dans les Réglages et cliquez sur « Ouvrir Réglages Système… »."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ウインドウを読むには「%@」の許可が必要です。設定の「一般」で「システム設定を開く…」をクリックしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "윈도우를 읽으려면 ‘%@’ 권한이 필요합니다. 일반 설정을 열고 ‘시스템 설정 열기…’를 클릭하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A permissão “%@” é necessária para ler as janelas. Abra “Geral” nos Ajustes e clique em “Abrir Ajustes do Sistema…”."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "需要“%@”权限才能读取窗口。请打开“通用”设置并点按“打开系统设置…”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "需要「%@」權限才能讀取視窗。請打開「一般」設定，然後按一下「打開系統設定⋯」。"
          }
        }
      }
    },

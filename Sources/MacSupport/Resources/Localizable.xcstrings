        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "윈도우를 앞으로 가져오기 전에 작업이 중단되었습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A operação foi interrompida antes de a janela ser trazida para a frente."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在窗口移到最前面之前，操作已中断。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在視窗移至最前方之前，操作已中斷。"
          }
        }
      }
    },

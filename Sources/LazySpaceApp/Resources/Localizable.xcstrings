    "coordinator.couldNotConfirmThatThe" : {
      "comment" : "Arguments: 1 = `AccessPane.name()`.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es konnte nicht bestätigt werden, dass das Fenster zum Ziel-Space bewegt wurde. Prüfe die Berechtigung „%@“, die Eingabebeobachtung, die Einstellungen von Mission Control und ob sich die obere Mitte des Fensters ziehen lässt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Could not confirm that the window moved to the target Space. Check the %@ permission, input observation, Mission Control settings, and whether the top center of the window can be dragged."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo confirmar que la ventana se movió al Space de destino. Comprueba el permiso “%@”, la observación de la entrada, los ajustes de Mission Control y si se puede arrastrar el centro del borde superior de la ventana."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de confirmer que la fenêtre a été déplacée vers le Space cible. Vérifiez l’autorisation « %@ », l’observation de la saisie, les réglages de Mission Control et si le centre du bord supérieur de la fenêtre peut être glissé."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目標の操作スペースへのウインドウの移動を確認できませんでした。「%@」の許可・入力監視・Mission Controlの設定と、ウインドウの上端中央をドラッグできるかを確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "윈도우가 대상 Space로 이동했는지 확인할 수 없습니다. ‘%@’ 권한, 입력 관찰, Mission Control 설정, 그리고 윈도우의 상단 가운데를 드래그할 수 있는지 확인하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível confirmar que a janela se moveu para o Space de destino. Verifique a permissão “%@”, a observação da entrada, os ajustes do Mission Control e se o centro da borda superior da janela pode ser arrastado."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法确认窗口已移到目标空间。请检查“%@”权限、输入监控、调度中心设置，以及窗口顶部中央是否可以拖移。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法確認視窗已移至目標空間。請檢查「%@」權限、輸入觀察、「指揮中心」設定，以及是否能拖移視窗的頂部中央。"
          }
        }
      }
    },
    "coordinator.couldNotConfirmTheCurrent" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das aktuelle Fenster-Layout konnte nicht bestätigt werden. Alle Spaces bleiben angehalten. Wähle erneut „LazySpace fortsetzen“."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Could not confirm the current window layout. All Spaces remain paused. Try Resume again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo confirmar la disposición actual de las ventanas. Todos los Spaces siguen en pausa. Vuelve a elegir “Reanudar LazySpace”."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de confirmer la disposition actuelle des fenêtres. Tous les Spaces restent en pause. Choisissez de nouveau « Reprendre LazySpace »."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在のウインドウ配置を確認できないため、一時停止を続けています。もう一度再開してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "현재 윈도우 레이아웃을 확인할 수 없습니다. 모든 Space가 일시 정지된 상태입니다. ‘LazySpace 재개’를 다시 선택하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível confirmar o layout atual das janelas. Todos os Spaces continuam em pausa. Escolha “Retomar o LazySpace” de novo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法确认当前窗口布局。所有空间仍处于暂停状态。请再次尝试继续运行LazySpace。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法確認目前的視窗佈局。所有空間仍維持暫停。請再次選擇「繼續執行LazySpace」。"
          }
        }
      }
    },

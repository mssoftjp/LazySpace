    "coordinator.theMoveRequestWasSent" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Bewegungsanfrage wurde gesendet, aber der Space des Fensters änderte sich nicht, während LazySpace wartete. Es wurde kein Ziehen versucht; das Fenster kann sich noch bewegen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The move request was sent, but the window's Space did not change while LazySpace waited. No drag was attempted; the window may still move."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La solicitud de movimiento se envió, pero el Space de la ventana no cambió mientras LazySpace esperaba. No se intentó arrastrar; la ventana aún puede moverse."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La demande de déplacement a été envoyée, mais le Space de la fenêtre n’a pas changé pendant l’attente de LazySpace. Aucun glissement n’a été tenté ; la fenêtre peut encore bouger."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "移動の要求は送りましたが、待っている間にウインドウの所属は変わりませんでした。ドラッグには切り替えていません。遅れて移動することがあります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이동 요청을 보냈지만 LazySpace가 기다리는 동안 윈도우의 Space가 바뀌지 않았습니다. 드래그는 시도하지 않았으며, 윈도우가 나중에 이동할 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A solicitação de movimento foi enviada, mas o Space da janela não mudou enquanto o LazySpace esperava. Nenhum arrasto foi tentado; a janela ainda pode se mover."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已发出移动请求，但在LazySpace等待期间，窗口所在的空间没有变化。未尝试拖移；窗口仍可能移动。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已送出移動要求，但在LazySpace等待期間，視窗所屬的空間沒有改變。未嘗試拖移；視窗仍可能移動。"
          }
        }
      }
    },

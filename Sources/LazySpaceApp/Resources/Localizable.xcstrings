    "coordinator.automaticArrangementIsOffBecause" : {
      "comment" : "Arguments: 1 = `AccessPane.name()`.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die automatische Anordnung ist aus, weil Eingaben nicht beobachtet werden können und sich Fenster sonst bewegen könnten, während du sie benutzt. Prüfe die Berechtigung „%@“."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatic arrangement is off because input cannot be observed, so windows could move while you use them. Check the %@ permission."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La organización automática está desactivada porque no se puede observar la entrada, así que las ventanas podrían moverse mientras las usas. Comprueba el permiso “%@”."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’organisation automatique est désactivée parce que la saisie ne peut pas être observée : les fenêtres pourraient bouger pendant que vous les utilisez. Vérifiez l’autorisation « %@ »."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "入力を観測できないため、自動整列を止めています。操作中のウインドウを動かさないためです。「%@」の許可を確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "입력을 관찰할 수 없어 사용 중인 윈도우가 움직일 수 있으므로 자동 정렬이 꺼져 있습니다. ‘%@’ 권한을 확인하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A organização automática está desativada porque a entrada não pode ser observada e as janelas poderiam se mover enquanto você as usa. Verifique a permissão “%@”."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "由于无法观测输入，自动排列已关闭，以免窗口在你使用时移动。请检查“%@”权限。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "由於無法觀察輸入，視窗可能會在你使用時被移動，因此自動排列已關閉。請檢查「%@」權限。"
          }
        }
      }
    },
    "coordinator.automaticArrangementIsOffBecauseMore" : {
      "comment" : "Arguments: 1 = `MacItem.separateSpaces`.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die automatische Anordnung ist aus, weil mehr als ein Display angeschlossen ist und „%@“ in Mission Control ausgeschaltet ist. Schalte es unter Systemeinstellungen › Schreibtisch & Dock ein und melde dich dann ab und wieder an."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatic arrangement is off because more than one display is connected and Mission Control’s “%@” is off. Turn it on in System Settings › Desktop & Dock, then log out and back in."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La organización automática está desactivada porque hay más de una pantalla conectada y la opción “%@” de Mission Control está desactivada. Actívala en Ajustes del Sistema › Escritorio y Dock y luego cierra la sesión y vuelve a iniciarla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’organisation automatique est désactivée parce que plusieurs écrans sont connectés et que l’option « %@ » de Mission Control est désactivée. Activez-la dans Réglages Système › Bureau et Dock, puis fermez la session et rouvrez-la."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "複数のディスプレイをつないでいて、Mission Controlの「%@」がオフのため、自動整列を止めています。システム設定 › デスクトップとDockでオンにしてから、ログアウトしてログインし直してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "디스플레이가 2개 이상 연결되어 있고 Mission Control의 ‘%@’이(가) 꺼져 있어 자동 정렬이 꺼져 있습니다. 시스템 설정 › 데스크탑 및 Dock에서 켠 다음 로그아웃했다가 다시 로그인하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A organização automática está desativada porque há mais de uma tela conectada e a opção “%@” do Mission Control está desativada. Ative-a em Ajustes do Sistema › Mesa e Dock e depois encerre a sessão e inicie-a de novo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "由于连接了多台显示器且调度中心的“%@”已关闭，自动排列已关闭。请在系统设置 › 桌面与程序坞中将其打开，然后退出登录并重新登录。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "由於連接了多部顯示器，且「指揮中心」的「%@」已關閉，因此自動排列已關閉。請在「系統設定」›「桌面與Dock」中開啟此選項，然後登出再重新登入。"
          }
        }
      }
    },
    "coordinator.automaticArrangementIsOffBecauseThe" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die automatische Anordnung ist aus, weil die Konfigurationsdatei nicht angewendet werden konnte. Sie schaltet sich ein, sobald die Datei korrigiert ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatic arrangement is off because the configuration file could not be applied. It turns on when the file is fixed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La organización automática está desactivada porque no se pudo aplicar el archivo de configuración. Se activará cuando el archivo esté corregido."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’organisation automatique est désactivée parce que le fichier de configuration n’a pas pu être appliqué. Elle s’active dès que le fichier est corrigé."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "設定ファイルを適用できないため、自動整列を止めています。ファイルを直すと使えるようになります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "설정 파일을 적용할 수 없어 자동 정렬이 꺼져 있습니다. 파일을 수정하면 켜집니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A organização automática está desativada porque o arquivo de configuração não pôde ser aplicado. Ela é ativada quando o arquivo for corrigido."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "由于无法应用配置文件，自动排列已关闭。修正文件后会自动打开。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "由於無法套用設定檔，自動排列已關閉。修正檔案後即會開啟。"
          }
        }
      }
    },
    "coordinator.automaticArrangementIsOffIn" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die automatische Anordnung ist in diesem Space aus. Die manuelle Anordnung ist weiterhin verfügbar, und andere Spaces laufen weiter."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatic arrangement is off in this Space. Manual arrangement is still available, and other Spaces continue."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La organización automática está desactivada en este Space. La organización manual sigue disponible, y los demás Spaces continúan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’organisation automatique est désactivée dans ce Space. L’organisation manuelle reste disponible, et les autres Spaces continuent."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この操作スペースの自動整列はオフです。手動の整列は使えます。他の操作スペースは続きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 Space에서 자동 정렬이 꺼져 있습니다. 수동 정렬은 계속 사용할 수 있으며, 다른 Space는 계속 정렬됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A organização automática está desativada neste Space. A organização manual continua disponível, e os outros Spaces continuam."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此空间的自动排列已关闭。仍可使用手动排列，其他空间照常继续。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此空間的自動排列已關閉。仍可使用手動排列，其他空間也會繼續。"
          }
        }
      }
    },
    "coordinator.automaticArrangementIsOffWhile" : {
      "comment" : "Arguments: 1 = `MacItem.stageManager`; 2 = `MacItem.stageManager`.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die automatische Anordnung ist aus, solange %@ eingeschaltet ist. Schalte %@ aus, um sie zu verwenden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatic arrangement is off while %@ is on. Turn off %@ to use it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La organización automática está desactivada mientras se usa %@. Para usarla, desactiva %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’organisation automatique est désactivée tant que %@ est activé. Désactivez %@ pour l’utiliser."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@の使用中は、自動整列を止めています。使うには%@をオフにしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@이(가) 켜져 있는 동안 자동 정렬이 꺼집니다. 자동 정렬을 사용하려면 %@을(를) 끄십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A organização automática fica desativada enquanto o %@ está ativado. Desative o %@ para usá-la."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@打开时，自动排列会关闭。要使用自动排列，请关闭%@。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "開啟「%@」時，自動排列會關閉。若要使用自動排列，請關閉「%@」。"
          }
        }
      }
    },

{
  "sourceLanguage" : "en",
  "strings" : {
    "config.andUseTheSameShortcut" : {
      "comment" : "Arguments: 1 = `label`; 2 = `name`; 3 = `other`; 4 = `key.display`.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: %@ und %@ verwenden denselben Kurzbefehl %@."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: %@ and %@ use the same shortcut %@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: %@ y %@ usan el mismo atajo %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ : %@ et %@ utilisent le même raccourci %@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: %@と%@が同じショートカット%@を使っています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: %@ 및 %@이(가) 같은 단축키 %@을(를) 사용합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: %@ e %@ usam o mesmo atalho %@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@：%2$@和%3$@使用了相同的快捷键%4$@。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@：%@和%@使用相同的快速鍵%@。"
          }
        }
      }
    },

    "nativeShortcutStatus.openKeyboardSettingsChooseKeyboard" : {
      "comment" : "Arguments: 1 = `leftName`; 2 = `rightName`.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffne die Tastatureinstellungen, wähle Tastaturkurzbefehle … › Mission Control, schalte dann „%@“ und „%@“ ein und weise ihnen Tasten zu."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open Keyboard Settings, choose Keyboard Shortcuts… › Mission Control, then turn on “%@” and “%@” and assign keys to them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre los ajustes del teclado, elige Atajos de teclado… › Mission Control y luego activa “%@” y “%@” y asígnales teclas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouvrez les réglages Clavier, choisissez Raccourcis clavier… › Mission Control, puis activez « %@ » et « %@ » et attribuez-leur des touches."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「キーボード設定を開く…」を押し、「キーボードショートカット…」の「Mission Control」で、「%@」と「%@」をオンにしてキーを割り当ててください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘키보드 설정 열기…’를 클릭하고 키보드 단축키… › Mission Control을 선택한 다음, ‘%@’ 및 ‘%@’을(를) 켜고 키를 할당하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abra os Ajustes de Teclado, escolha Atalhos de Teclado… › Mission Control, ative “%@” e “%@” e atribua teclas a eles."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请点按“打开键盘设置…”，选择键盘快捷键… › 调度中心，然后打开“%@”和“%@”并为其分配按键。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請按一下「打開鍵盤設定⋯」，選擇「鍵盤快速鍵⋯」›「指揮中心」，然後開啟「%@」和「%@」並為其指定按鍵。"
          }
        }
      }
    },
    "nativeShortcutStatus.savingRemovesSoThisConflict" : {
      "comment" : "Arguments: 1 = `shown`.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beim Sichern wird %@ entfernt, daher verschwindet dieser Konflikt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saving removes %@, so this conflict goes away."
          }
        },
        "es" : {

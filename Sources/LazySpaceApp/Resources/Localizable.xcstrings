    "settingsWindow.notificationsNotAsked" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS hat nicht gefragt, ob LazySpace Mitteilungen senden darf. Falls du LazySpace von einem vorübergehenden Ort geöffnet hast, beende es und öffne es aus dem Ordner „Programme“."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS did not ask whether LazySpace may send notifications. If you opened LazySpace from a temporary location, quit it and open it from the Applications folder."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS no preguntó si LazySpace puede enviar notificaciones. Si abriste LazySpace desde una ubicación temporal, sal de la app y ábrela desde la carpeta Aplicaciones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS n’a pas demandé si LazySpace peut envoyer des notifications. Si vous avez ouvert LazySpace depuis un emplacement temporaire, quittez-le et ouvrez-le depuis le dossier Applications."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOSはLazySpaceが通知を送ってよいかを確認しませんでした。一時的な場所から開いている場合は、終了して「アプリケーション」フォルダから開き直してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS가 LazySpace의 알림 전송 허용 여부를 묻지 않았습니다. 임시 위치에서 LazySpace를 열었다면 종료한 다음 응용 프로그램 폴더에서 여십시오."
          }
        },

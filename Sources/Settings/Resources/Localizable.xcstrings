    "config.keysNeedsAModifierKey" : {
      "comment" : "Arguments: 1 = `name`; 2 = `key.display`.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "keys.%@: %@ braucht im Hauptmodus eine Sondertaste, weil eine einzelne Taste die normale Texteingabe abfangen würde. Einzelne Tasten sind für Funktionstasten oder innerhalb eines Modus erlaubt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "keys.%@: %@ needs a modifier key in the main mode because a single key would capture normal typing. Single keys are allowed for function keys or inside a mode."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "keys.%@: %@ necesita una tecla modificadora en el modo main, porque una sola tecla capturaría la escritura normal. Se permiten teclas solas para las teclas de función o dentro de un modo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "keys.%@ : %@ nécessite une touche de modification dans le mode principal, car une touche seule capturerait la saisie normale. Les touches seules sont autorisées pour les touches de fonction ou dans un mode."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",

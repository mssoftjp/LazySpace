    "cli.currentSpaceOnlyOrdinaryDesktops" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "* = aktueller Space. Nur gewöhnliche Schreibtische sind nummeriert, in der Reihenfolge von macOS auf jedem Display. Vollbild- und Split View-Spaces haben keine Nummer."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "* = current Space. Only ordinary desktops are numbered, in macOS order on each display. Full-screen / Split View spaces are unnumbered."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "* = Space actual. Solo se numeran los escritorios normales, en el orden de macOS en cada pantalla. Los Spaces de pantalla completa / Split View no se numeran."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "* = Space actuel. Seuls les bureaux ordinaires sont numérotés, dans l’ordre de macOS sur chaque écran. Les Spaces en plein écran / Split View ne sont pas numérotés."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "* = 現在の操作スペース。通常のデスクトップだけをディスプレイごとにmacOSの並び順で数えます。フルスクリーン・Split Viewに番号は付きません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "* = 현재 Space. 일반 데스크탑에만 디스플레이별로 macOS 순서에 따라 번호가 매겨집니다. 전체 화면 / Split View Space에는 번호가 없습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "* = Space atual. Só as mesas comuns são numeradas, na ordem do macOS em cada tela. Spaces de tela cheia / Split View não são numerados."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "* = 当前空间。仅为普通桌面编号，按macOS在每个显示器上的顺序排列。全屏幕和分屏浏览空间不编号。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "* = 目前的空間。只有一般桌面會編號，並依各顯示器上的macOS順序排列。全螢幕/分割顯示的空間不編號。"
          }
        }
      }
    },

        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "result.id e operationID são a operação. requestID é o recibo. Eles não são intercambiáveis."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "result.id和operationID表示操作，requestID表示回执。两者不可互换。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "result.id和operationID代表操作，requestID代表回執。兩者不可互換。"
          }
        }
      }
    },
    "cliHelp.jSONOutputScriptsShouldRead" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skripte sollten die strukturierten Felder lesen, nicht die für Menschen gedachten Meldungen, die der Anzeigesprache folgen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scripts should read the structured fields rather than the human-readable messages, which follow the display language."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los scripts deben leer los campos estructurados y no los mensajes para personas, que siguen el idioma de la interfaz."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les scripts doivent lire les champs structurés plutôt que les messages lisibles par l’utilisateur, qui suivent la langue d’affichage."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スクリプトでは、表示言語に従う人向けのメッセージではなく、構造化されたフィールドを読んでください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "스크립트에서는 표시 언어를 따르는 사람용 메시지 대신 구조화된 필드를 읽으십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scripts devem ler os campos estruturados, não as mensagens legíveis por pessoas, que seguem o idioma de exibição."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "脚本应读取结构化字段，而不是随显示语言变化的人类可读消息。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "工序指令應讀取結構化的欄位，而非依顯示語言而異的使用者訊息。"
          }
        }
      }
    },

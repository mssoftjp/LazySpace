      }
    },
    "cliHelp.explicitTargetsRequestTokenDoes" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "request-token schreibt kein Token in die Konfigurationsdatei. Nach einem Neustart von LazySpace sind alte Tokens unbrauchbar."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "request-token does not write a token to the configuration file. Restarting LazySpace makes old tokens unusable."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "request-token no escribe ningún token en el archivo de configuración. Al reiniciar LazySpace, los tokens antiguos dejan de servir."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "request-token n’écrit aucun jeton dans le fichier de configuration. Redémarrer LazySpace rend les anciens jetons inutilisables."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "request-tokenは設定ファイルへトークンを書きません。アプリを再起動すると古いトークンは使えません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "request-token은 설정 파일에 토큰을 기록하지 않습니다. LazySpace를 다시 시작하면 이전 토큰은 사용할 수 없습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "request-token não grava nenhum token no arquivo de configuração. Reiniciar o LazySpace torna os tokens antigos inutilizáveis."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "request-token不会将令牌写入配置文件。重新启动LazySpace后，旧令牌将无法使用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "request-token不會將代號寫入設定檔。重新啟動LazySpace後，舊的代號將無法使用。"
          }
        }
      }
    },
    "cliHelp.explicitTargetsResendingTheSame" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird dasselbe Token erneut gesendet, kommt nur sein Ergebnis zurück; der Vorgang wird nicht noch einmal ausgelöst. Ein neuer Versuch braucht ein neues Token."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resending the same token returns its outcome and does not dispatch again. A new attempt needs a new token."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reenviar el mismo token devuelve su resultado y no vuelve a ejecutar nada. Un nuevo intento necesita un token nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Renvoyer le même jeton retourne son résultat sans relancer l’opération. Une nouvelle tentative exige un nouveau jeton."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同じトークンの再送は結果を返すだけで、操作はもう始まりません。やり直すときは新しいトークンが必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "같은 토큰을 다시 보내면 결과만 반환하며 작업을 다시 실행하지 않습니다. 새로 시도하려면 새 토큰이 필요합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reenviar o mesmo token devolve o resultado dele e não despacha de novo. Uma nova tentativa precisa de um novo token."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "重新发送同一令牌只会返回其结果，不会再次执行。重新尝试需要新的令牌。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "重新傳送相同的代號只會傳回其結果，不會再次執行。重新嘗試需要新的代號。"
          }
        }
      }
    },
    "cliHelp.explicitTargetsTheCLIReserves" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ohne --request-id reserviert die CLI ein Token, sendet die Änderung einmal und gibt das Token bei einem Fehlschlag aus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The CLI reserves a token when --request-id is omitted, sends the mutation once, and prints that token on failure."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La CLI reserva un token cuando se omite --request-id, envía el cambio una vez e imprime ese token si falla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quand --request-id est omis, la CLI réserve un jeton, envoie la modification une seule fois et affiche ce jeton en cas d’échec."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "省略するとCLIが予約してから変更を1回送り、失敗時もそのトークンを出します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "--request-id를 생략하면 CLI가 토큰을 예약하고 변경을 한 번 보내며, 실패하면 해당 토큰을 출력합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A CLI reserva um token quando --request-id é omitido, envia a alteração uma vez e imprime esse token em caso de falha."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "省略--request-id时，CLI会预留一个令牌，只发送一次更改，并在失败时输出该令牌。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",

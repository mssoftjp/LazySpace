    "cliHelp.sectionSpaces" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spaces (direkt, wenn der Ziel-Space ein Fenster hat, das LazySpace kennt; sonst Space für Space über die Mission Control-Kurzbefehle, die bereits in den Systemeinstellungen festgelegt sind und nicht geändert werden; ist ein Kurzbefehl aus, sendet das schrittweise Wechseln nichts; Nummern zählen nur gewöhnliche Schreibtische wie in list-spaces)"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spaces (direct when the target Space has a window LazySpace knows; otherwise one Space at a time using the Mission Control shortcuts already set in System Settings, which are not changed, and stepping sends nothing if a shortcut is off; numbers count only ordinary desktops in list-spaces)"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spaces (directo cuando el Space de destino tiene una ventana que LazySpace conoce; si no, Space a Space con los atajos de Mission Control ya definidos en Ajustes del Sistema, que no se cambian, y el paso a paso no envía nada si un atajo está desactivado; los números cuentan solo los escritorios normales de list-spaces)"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spaces (direct quand le Space cible contient une fenêtre connue de LazySpace ; sinon un Space à la fois avec les raccourcis Mission Control déjà définis dans Réglages Système, qui ne sont pas modifiés, et le passage pas à pas n’envoie rien si un raccourci est désactivé ; les numéros ne comptent que les bureaux ordinaires de list-spaces)"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "操作スペース（移動先のウインドウやアプリを前面にできれば直接。できなければ近くの操作スペースまで直接移り、残りをシステム設定のMission Controlショートカットで1つずつ移動し、設定は変えない。オフなら1つずつの移動は送らない。番号はlist-spacesの通常デスクトップだけを数える）"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Space(대상 Space에 LazySpace가 아는 윈도우가 있으면 직접 이동. 없으면 시스템 설정에 이미 지정된 Mission Control 단축키로 Space를 하나씩 이동하며, 이 단축키는 변경하지 않음. 단축키가 꺼져 있으면 하나씩 이동하지 않음. 번호는 list-spaces의 일반 데스크탑만 셈)"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spaces (direto quando o Space de destino tem uma janela que o LazySpace conhece; caso contrário, um Space por vez com os atalhos do Mission Control já definidos nos Ajustes do Sistema, que não são alterados, e o avanço por etapas não envia nada se um atalho estiver desativado; os números contam só as mesas comuns de list-spaces)"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "空间（目标空间中有LazySpace已知的窗口时直接切换；否则使用系统设置中已设定的调度中心快捷键逐个切换空间，这些快捷键不会被更改，如果某个快捷键已关闭，则不会逐个切换；编号只计算list-spaces中的普通桌面）"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "空間（目標空間中有LazySpace已知的視窗時直接切換；否則使用「系統設定」中已設定的「指揮中心」快速鍵一次切換一個空間，且不會更改這些設定；若快速鍵已關閉，則不會逐一切換；編號只計算list-spaces中的一般桌面）"
          }
        }
      }
    },

    "coordinator.toMoveTheWindowAnd" : {
      "comment" : "Arguments: 1 = `title`.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um das Fenster zu bewegen und mit ihm zu wechseln, schalte „%@“ unter Einstellungen › Kurzbefehle ein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To move the window and switch with it, turn on “%@” in Settings › Shortcuts."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para mover la ventana y cambiar con ella, activa “%@” en Ajustes › Atajos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",

    "settingsWindow.accessHelp" : {
      "comment" : "Arguments: 1 = `AccessPane.name()`.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schalte LazySpace unter Datenschutz & Sicherheit › %@ ein. Falls es bereits eingeschaltet ist und sich hier nichts ändert, ist vielleicht noch eine ältere Kopie der App eingetragen: Wähle LazySpace aus, klicke auf die Taste „Entfernen“ (−) und dann erneut auf „Systemeinstellungen öffnen …“."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turn on LazySpace in Privacy & Security › %@. If it’s already on but this doesn’t change, an older copy of the app may still be listed: select LazySpace, click the Remove button (−), then click Open System Settings… again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activa LazySpace en Privacidad y seguridad › %@. Si ya está activado pero esto no cambia, puede que siga en la lista una copia antigua de la app: selecciona LazySpace, haz clic en el botón Eliminar (−) y vuelve a hacer clic en “Abrir Ajustes del Sistema…”."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activez LazySpace dans Confidentialité et sécurité › %@. S’il est déjà activé mais que rien ne change ici, une ancienne copie de l’app figure peut-être encore dans la liste : sélectionnez LazySpace, cliquez sur le bouton Supprimer (−), puis cliquez de nouveau sur « Ouvrir Réglages Système… »."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プライバシーとセキュリティ › %@でLazySpaceをオンにしてください。オンなのにここが変わらない場合は、古いバージョンのアプリが登録されている可能性があります。LazySpaceを選択して削除ボタン（−）をクリックし、もう一度「システム設定を開く…」をクリックしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "개인정보 보호 및 보안 › %@에서 LazySpace를 켜십시오. 이미 켜져 있는데도 이 상태가 바뀌지 않으면 이전 버전의 앱이 목록에 남아 있을 수 있습니다. LazySpace를 선택하고 제거 버튼(−)을 클릭한 다음 ‘시스템 설정 열기…’를 다시 클릭하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ative o LazySpace em Privacidade e Segurança › %@. Se já estiver ativado, mas isto não mudar, uma cópia antiga do app pode ainda estar na lista: selecione o LazySpace, clique no botão Remover (−) e clique em “Abrir Ajustes do Sistema…” de novo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请在隐私与安全 › %@中打开LazySpace。如果已经打开但此处没有变化，列表中可能仍有该应用的旧副本：请选择LazySpace，点按移除按钮（−），然后再次点按“打开系统设置…”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請在「隱私權與安全性」›「%@」中開啟LazySpace。如果已開啟但此處沒有變化，列表中可能仍有舊版的App：請選取LazySpace，按一下移除按鈕（−），然後再按一次「打開系統設定⋯」。"
          }
        }
      }
    },
